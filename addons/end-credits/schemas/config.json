{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "End Credits",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": { "type": "boolean", "title": "Enable End Credits", "default": true },
    "enabledPlatforms": { "type": "array", "title": "Platforms to collect names from", "items": { "type": "string", "enum": ["twitch", "youtube", "kick", "tiktok", "streamlabs", "kofi", "streamelements"] }, "uniqueItems": true, "maxItems": 7, "default": ["twitch", "youtube", "kick", "tiktok", "streamlabs", "kofi", "streamelements"] },
    "enabledSections": { "type": "array", "title": "Sections to show", "items": { "type": "string", "enum": ["followers", "members", "gifters", "supporters", "raiders", "moderators", "chatters"] }, "uniqueItems": true, "minItems": 1, "maxItems": 7, "default": ["followers", "members", "gifters", "supporters", "raiders", "moderators"] },
    "showSimulatedPreviews": { "type": "boolean", "title": "Show simulator events without saving them", "default": true },
    "maximumNamesPerSection": { "type": "integer", "title": "Most names per section", "minimum": 10, "maximum": 1000, "default": 200 },
    "maximumNameLength": { "type": "integer", "title": "Longest name shown", "minimum": 12, "maximum": 100, "default": 40 },
    "headline": { "type": "string", "title": "Headline", "maxLength": 80, "default": "That's a wrap!" },
    "subtitle": { "type": "string", "title": "Subtitle", "maxLength": 160, "default": "Thank you for hanging out today" },
    "endMessage": { "type": "string", "title": "Closing line", "maxLength": 120, "default": "Thanks for watching!" },
    "followersTitle": { "type": "string", "title": "Followers heading", "minLength": 1, "maxLength": 80, "default": "New Followers" },
    "membersTitle": { "type": "string", "title": "Subscribers heading", "minLength": 1, "maxLength": 80, "default": "Subscribers & Members" },
    "giftersTitle": { "type": "string", "title": "Gifters heading", "minLength": 1, "maxLength": 80, "default": "Gifters" },
    "supportersTitle": { "type": "string", "title": "Supporters heading", "minLength": 1, "maxLength": 80, "default": "Supporters" },
    "raidersTitle": { "type": "string", "title": "Raiders heading", "minLength": 1, "maxLength": 80, "default": "Raiders" },
    "moderatorsTitle": { "type": "string", "title": "Moderators heading", "minLength": 1, "maxLength": 80, "default": "Moderators" },
    "chattersTitle": { "type": "string", "title": "Chat heading", "minLength": 1, "maxLength": 80, "default": "Chat" },
    "showGiftCounts": { "type": "boolean", "title": "Show how many gifts each gifter sent", "default": true },
    "autoRollOnShow": { "type": "boolean", "title": "Roll when the scene with the credits is shown", "default": true },
    "loop": { "type": "boolean", "title": "Loop the credits", "default": false },
    "scrollSpeed": { "type": "integer", "title": "Scroll speed (pixels per second)", "minimum": 20, "maximum": 300, "default": 70 },
    "columns": { "type": "integer", "title": "Name columns", "minimum": 1, "maximum": 4, "default": 2 },
    "platformColors": { "type": "boolean", "title": "Color names by platform", "default": true },
    "backgroundMode": { "type": "string", "title": "Background", "enum": ["glass", "solid", "none"], "default": "none" },
    "backgroundColor": { "type": "string", "title": "Background color", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#0b0f17" },
    "backgroundOpacity": { "type": "number", "title": "Background opacity", "minimum": 0, "maximum": 1, "default": 0.72 },
    "accentColor": { "type": "string", "title": "Heading color", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#7ff5cc" },
    "textColor": { "type": "string", "title": "Name color", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#ffffff" },
    "fontFamily": { "type": "string", "title": "Font style", "enum": ["broadcast", "display", "serif", "mono"], "default": "broadcast" },
    "fontSize": { "type": "integer", "title": "Name font size", "minimum": 18, "maximum": 96, "default": 38 },
    "enableModeratorCommand": { "type": "boolean", "title": "Let moderators use the credits command", "default": true },
    "commandName": { "type": "string", "title": "Credits command", "pattern": "^!?[A-Za-z0-9][A-Za-z0-9_-]{0,39}$", "default": "credits" }
  }
}
