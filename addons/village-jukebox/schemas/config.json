{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Village Jukebox",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": { "type": "boolean", "title": "Enable Village Jukebox", "default": false },
    "rightsAcknowledged": { "type": "boolean", "title": "I understand that I am responsible for permission to rebroadcast requested music", "default": false },
    "requestCommand": { "type": "string", "title": "Song request command", "description": "Do not include the ! prefix.", "pattern": "^[a-z][a-z0-9-]{0,39}$", "default": "sr" },
    "queueCommand": { "type": "string", "title": "Queue status command", "pattern": "^[a-z][a-z0-9-]{0,39}$", "default": "queue" },
    "whenCommand": { "type": "string", "title": "Viewer position command", "pattern": "^[a-z][a-z0-9-]{0,39}$", "default": "when" },
    "wrongSongCommand": { "type": "string", "title": "Remove own request command", "pattern": "^[a-z][a-z0-9-]{0,39}$", "default": "wrongsong" },
    "voteSkipCommand": { "type": "string", "title": "Vote-skip command", "pattern": "^[a-z][a-z0-9-]{0,39}$", "default": "voteskip" },
    "moderatorSkipCommand": { "type": "string", "title": "Moderator skip command", "pattern": "^[a-z][a-z0-9-]{0,39}$", "default": "skip" },
    "allowTextSearch": { "type": "boolean", "title": "Allow song-title searches", "description": "Direct YouTube links use far less API quota. Disable this to require links only.", "default": true },
    "dailyTextSearchLimit": { "type": "integer", "title": "Maximum title searches per UTC day", "description": "YouTube search requests are quota-expensive; direct links do not consume this safety allowance.", "minimum": 1, "maximum": 100, "default": 50 },
    "enabledPlatforms": { "type": "array", "title": "Platforms allowed to request", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "enum": ["twitch", "youtube", "kick", "tiktok"] }, "default": ["twitch", "youtube", "kick", "tiktok"] },
    "pointsPlatforms": { "type": "array", "title": "Platforms charged Viewer Foundation points", "description": "Twitch and Kick can be free commands or use their native rewards. YouTube and TikTok default to points.", "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "enum": ["twitch", "youtube", "kick", "tiktok"] }, "default": ["youtube", "tiktok"] },
    "pointsCost": { "type": "integer", "title": "Points per accepted request", "minimum": 1, "maximum": 1000000, "default": 100 },
    "rewardRequestsEnabled": { "type": "boolean", "title": "Accept Twitch and Kick reward requests", "default": false },
    "twitchRewardId": { "type": "string", "title": "Twitch Song Request reward ID", "description": "The reward must require viewer text input.", "maxLength": 256, "default": "" },
    "kickRewardId": { "type": "string", "title": "Kick Song Request reward ID", "description": "Kick reward failures cannot currently be refunded automatically.", "maxLength": 256, "default": "" },
    "maximumQueueSize": { "type": "integer", "title": "Maximum queued tracks", "minimum": 1, "maximum": 50, "default": 25 },
    "maximumRequestsPerViewer": { "type": "integer", "title": "Maximum active requests per viewer", "minimum": 1, "maximum": 5, "default": 1 },
    "viewerCooldownSeconds": { "type": "integer", "title": "Viewer request cooldown (seconds)", "minimum": 0, "maximum": 86400, "default": 60 },
    "maximumTrackMinutes": { "type": "integer", "title": "Maximum track length (minutes)", "minimum": 1, "maximum": 10, "default": 8 },
    "recentNoRepeatCount": { "type": "integer", "title": "Recently played no-repeat count", "minimum": 0, "maximum": 100, "default": 20 },
    "voteSkipRequired": { "type": "integer", "title": "Unique votes required to skip", "minimum": 1, "maximum": 100, "default": 5 },
    "secondsBetweenTracks": { "type": "integer", "title": "Pause between tracks (seconds)", "minimum": 1, "maximum": 60, "default": 4 },
    "announceNowPlaying": { "type": "boolean", "title": "Announce each track in its request platform", "default": true },
    "volume": { "type": "number", "title": "Player volume", "minimum": 0, "maximum": 1, "default": 0.7 },
    "backgroundColor": { "type": "string", "format": "color", "title": "Now Playing background", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#101820" },
    "accentColor": { "type": "string", "format": "color", "title": "Now Playing accent", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#7ff5cc" },
    "textColor": { "type": "string", "format": "color", "title": "Now Playing text", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#ffffff" },
    "fontFamily": { "type": "string", "title": "Now Playing font", "enum": ["broadcast", "display", "serif", "mono"], "default": "broadcast" }
  }
}
