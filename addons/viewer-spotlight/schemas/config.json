{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Viewer Spotlight",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": { "type": "boolean", "title": "Enable Viewer Spotlight", "default": false },
    "disclosureAccepted": { "type": "boolean", "title": "I understand selected viewer statistics will appear publicly on the overlay", "default": false },
    "commandName": { "type": "string", "title": "Self-request command", "description": "Create this command in Command Sync with no generated response. A viewer may request only their own card.", "pattern": "^[a-z][a-z0-9-]{0,63}$", "maxLength": 64, "default": "card" },
    "enabledPlatforms": { "type": "array", "title": "Allowed request platforms", "items": { "type": "string", "enum": ["twitch", "youtube", "kick", "tiktok"] }, "minItems": 1, "maxItems": 4, "uniqueItems": true, "default": ["twitch", "youtube", "kick", "tiktok"] },
    "viewerCooldownMinutes": { "type": "integer", "title": "Per-viewer cooldown (minutes)", "minimum": 1, "maximum": 1440, "default": 15 },
    "globalCooldownSeconds": { "type": "integer", "title": "Minimum time between cards (seconds)", "minimum": 2, "maximum": 3600, "default": 10 },
    "maximumQueueSize": { "type": "integer", "title": "Maximum queued cards", "minimum": 1, "maximum": 20, "default": 8 },
    "queueExpirySeconds": { "type": "integer", "title": "Drop queued requests after (seconds)", "minimum": 15, "maximum": 600, "default": 120 },
    "maximumCardsPerSession": { "type": "integer", "title": "Maximum cards per stream session", "minimum": 1, "maximum": 500, "default": 50 },
    "durationSeconds": { "type": "integer", "title": "Card duration (seconds)", "minimum": 3, "maximum": 60, "default": 10 },
    "ignoredViewerIds": { "type": "array", "title": "Ignored Viewer Foundation IDs", "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$", "maxLength": 64 }, "maxItems": 500, "uniqueItems": true, "default": [] },
    "showPlatformBadge": { "type": "boolean", "title": "Show source-platform badge", "default": true },
    "showAvatar": { "type": "boolean", "title": "Show validated profile picture when supplied", "default": true },
    "showPoints": { "type": "boolean", "title": "Show Viewer Foundation points", "default": true },
    "showLevel": { "type": "boolean", "title": "Show Viewer Foundation level", "default": true },
    "showObservedSessions": { "type": "boolean", "title": "Show observed session count", "description": "Approximate local observations, not watch time.", "default": false },
    "showObservedMessages": { "type": "boolean", "title": "Show observed message count", "description": "Lifetime local count retained by Community Analytics.", "default": false },
    "showObservedCommands": { "type": "boolean", "title": "Show observed command count", "description": "Lifetime local count retained by Community Analytics.", "default": false },
    "showEngagementScore": { "type": "boolean", "title": "Show capped monthly engagement score", "description": "Appears only when Community Analytics scoring is enabled and the viewer has a current-month observation.", "default": false },
    "showSeasonRank": { "type": "boolean", "title": "Show protected monthly rank", "description": "Appears only after Community Analytics reaches its configured minimum viewer cohort.", "default": false },
    "backgroundMode": { "type": "string", "title": "Card background", "enum": ["glass", "solid", "none"], "default": "glass" },
    "backgroundColor": { "type": "string", "format": "color", "title": "Background color", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#140d1f" },
    "backgroundOpacity": { "type": "number", "title": "Background opacity", "minimum": 0, "maximum": 1, "default": 0.94 },
    "accentColor": { "type": "string", "format": "color", "title": "Accent color", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#7ff5cc" },
    "textColor": { "type": "string", "format": "color", "title": "Text color", "pattern": "^#[0-9A-Fa-f]{6}$", "default": "#ffffff" },
    "fontFamily": { "type": "string", "title": "Font", "enum": ["broadcast", "display", "serif", "mono"], "default": "broadcast" }
  }
}
