{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Free Game Check","type":"object","additionalProperties":false,"properties":{"enabled":{"type":"boolean","title":"Enable Free Game Check","default":false},"rewardId":{"type":"string","title":"Twitch Free Games reward ID","maxLength":256,"default":""},"kickRewardId":{"type":"string","title":"Kick Free Games reward ID","maxLength":256,"default":""},"commandName":{"type":"string","title":"YouTube and TikTok command","pattern":"^[a-z][a-z0-9-]{0,63}$","default":"freegames"},"discordInviteUrl":{"type":"string","title":"Discord invite link shown in chat","description":"Use an https://discord.gg/... or https://discord.com/invite/... link.","pattern":"^$|^https://(?:discord\\.gg|discord\\.com/invite)/[A-Za-z0-9_-]{2,100}/?$","maxLength":160,"default":""},"guideMessage":{"type":"string","title":"Chat guide message","description":"Available variables: {name} and {discord}.","minLength":1,"maxLength":350,"default":"{name}, our current free-game list is in Discord: {discord}"},"guideCooldownMinutes":{"type":"integer","title":"Guide cooldown per viewer (minutes)","minimum":1,"maximum":1440,"default":10},"refreshMinutes":{"type":"integer","title":"Check every (minutes)","minimum":60,"maximum":1440,"default":180},"maximumPostsPerRefresh":{"type":"integer","title":"Maximum announcements per check","minimum":1,"maximum":5,"default":2},"announceInitial":{"type":"boolean","title":"Announce results from the first scan","default":false},"deliveryPlatforms":{"type":"array","title":"Automatic new-game chat destinations","items":{"type":"string","enum":["twitch","youtube","kick","tiktok"]},"uniqueItems":true,"maxItems":4,"default":[]},"discordEnabled":{"type":"boolean","title":"Post new games to Discord","default":false},"discordDestinationMode":{"type":"string","title":"Discord destination type","enum":["channel","forum"],"default":"channel"},"discordThreadId":{"type":"string","title":"Existing Discord forum-post ID (optional)","pattern":"^$|^[0-9]{5,30}$","maxLength":30,"default":""},"discordThreadName":{"type":"string","title":"New forum-post name","description":"Use {title} for the game title.","minLength":1,"maxLength":100,"default":"Free Game - {title}"},"discordWebhookName":{"type":"string","title":"Discord display name","minLength":1,"maxLength":80,"default":"THSV Free Game Check"}}}
