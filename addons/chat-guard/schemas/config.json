{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chat Guard",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": { "type": "boolean", "title": "Enable observe-only Chat Guard", "description": "Classifies matching public messages but never warns, deletes, times out, or bans.", "default": false },
    "enforcementEnabled": { "type": "boolean", "title": "Enable moderation enforcement", "description": "Keep off until Observe mode has been reviewed and the triggerless Streamer.bot controller is approved.", "default": false },
    "creatorApprovedEnforcement": { "type": "boolean", "title": "I approve automated moderation", "description": "A separate deliberate approval gate. Turning on enforcement without this confirmation remains observe-only.", "default": false },
    "enforcementMode": { "type": "string", "title": "Enforcement mode", "enum": ["observe", "warn", "delete", "timeout", "ban"], "default": "observe" },
    "timeoutSeconds": { "type": "integer", "title": "Timeout duration (seconds)", "minimum": 10, "maximum": 86400, "default": 60 },
    "warningMessage": { "type": "string", "title": "Warning message", "minLength": 1, "maxLength": 300, "default": "Please keep chat safe and follow the channel rules." },
    "maximumEnforcementsPerMinute": { "type": "integer", "title": "Maximum enforcement actions per minute", "minimum": 1, "maximum": 20, "default": 5 },
    "includeSimulated": { "type": "boolean", "title": "Include simulated messages", "description": "Keep disabled outside deliberate testing.", "default": false },
    "enabledPlatforms": { "type": "array", "title": "Platforms observed", "items": { "type": "string", "enum": ["twitch", "youtube", "kick", "tiktok"] }, "minItems": 1, "maxItems": 4, "uniqueItems": true, "default": ["twitch", "youtube", "kick", "tiktok"] },
    "ignoredAccounts": { "type": "array", "title": "Ignored stable accounts", "description": "One account per line using platform|stable-user-id. Names are not accepted.", "items": { "type": "string", "minLength": 3, "maxLength": 330, "pattern": "^(twitch|youtube|kick|tiktok)\\|.+$" }, "maxItems": 500, "uniqueItems": true, "default": [] },
    "exemptBroadcaster": { "type": "boolean", "title": "Exempt broadcaster", "default": true },
    "exemptModerators": { "type": "boolean", "title": "Exempt moderators", "default": true },
    "exemptVips": { "type": "boolean", "title": "Exempt VIPs", "default": true },
    "exemptSubscribers": { "type": "boolean", "title": "Exempt subscribers and members", "default": false },
    "blockedTerms": { "type": "array", "title": "Literal terms to flag", "description": "One literal term per line. Matching ignores case; regular expressions are not accepted.", "items": { "type": "string", "minLength": 1, "maxLength": 80 }, "maxItems": 100, "uniqueItems": true, "default": [] },
    "blockedDomains": { "type": "array", "title": "Blocked domains", "description": "One hostname per line without a path, port, or protocol. Subdomains match their parent rule.", "items": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9.-]+$" }, "maxItems": 200, "uniqueItems": true, "default": [] },
    "allowedDomains": { "type": "array", "title": "Allowed domains only", "description": "Optional. When non-empty, links outside these hostnames are flagged. Subdomains match their parent rule.", "items": { "type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[A-Za-z0-9.-]+$" }, "maxItems": 200, "uniqueItems": true, "default": [] },
    "detectLinks": { "type": "boolean", "title": "Flag excessive links", "default": true },
    "maximumLinks": { "type": "integer", "title": "Allowed links per message", "minimum": 0, "maximum": 20, "default": 2 },
    "detectCaps": { "type": "boolean", "title": "Flag excessive capital letters", "default": true },
    "minimumCapsLetters": { "type": "integer", "title": "Minimum letters before caps rule", "minimum": 4, "maximum": 100, "default": 12 },
    "maximumCapsPercent": { "type": "integer", "title": "Capital-letter threshold (%)", "minimum": 50, "maximum": 100, "default": 80 },
    "detectRepeatedCharacters": { "type": "boolean", "title": "Flag repeated characters", "default": true },
    "maximumCharacterRun": { "type": "integer", "title": "Allowed identical characters in a row", "minimum": 3, "maximum": 50, "default": 8 },
    "detectLongMessages": { "type": "boolean", "title": "Flag long messages", "default": true },
    "maximumMessageCharacters": { "type": "integer", "title": "Allowed message characters", "minimum": 40, "maximum": 2000, "default": 500 },
    "detectRepeatedMessages": { "type": "boolean", "title": "Flag repeated messages", "default": true },
    "repeatWindowSeconds": { "type": "integer", "title": "Repeat window (seconds)", "minimum": 5, "maximum": 300, "default": 30 },
    "repeatMessageCount": { "type": "integer", "title": "Matching messages before flag", "minimum": 2, "maximum": 10, "default": 3 },
    "retainedIncidents": { "type": "integer", "title": "Maximum incidents retained", "minimum": 10, "maximum": 1000, "default": 200 },
    "retentionHours": { "type": "integer", "title": "Retention window (hours)", "minimum": 1, "maximum": 168, "default": 24 },
    "maximumTrackedObservations": { "type": "integer", "title": "Maximum repeat observations", "minimum": 50, "maximum": 2000, "default": 500 }
  }
}
