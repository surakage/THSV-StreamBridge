{
  "intro": "Wild Village Critters wander onto your stream now and then. Viewers throw Jars with !catch, paid with Viewer Foundation points, a channel point reward or a gift, and every catch goes into their own Field Journal. No Streamer.bot import is needed.",
  "order": [
    "enabled",
    "platforms",
    "commandPlatforms",
    "catchCommand",
    "honeyWord",
    "moonWord",
    "critterSet",
    "customCritters",
    "jarCost",
    "honeyCost",
    "moonCost",
    "rewardThrows",
    "toggleRewards",
    "catchMode",
    "throwCooldownSeconds",
    "catchCap",
    "guardianCap",
    "spawnMinMinutes",
    "spawnMaxMinutes",
    "visitMode",
    "activeChatters",
    "activeMinutes",
    "onlyWhenChatting",
    "commonWeight",
    "uncommonWeight",
    "rareWeight",
    "guardianWeight",
    "guardianMonthlyLimit",
    "glimmerOdds",
    "commonSeconds",
    "uncommonSeconds",
    "rareSeconds",
    "guardianSeconds",
    "commonFlee",
    "uncommonFlee",
    "rareFlee",
    "guardianFlee",
    "announceSpawns",
    "spawnMessage",
    "glimmerSpawnMessage",
    "rewardSpawnMessage",
    "caughtMessage",
    "glimmerCaughtMessage",
    "announceEntry",
    "entryMessage",
    "announceMisses",
    "missedMessage",
    "fledMessage",
    "announceLeaves",
    "leftMessage",
    "noPointsMessage",
    "rewardOnlyMessage",
    "noCritterMessage",
    "journalMessage",
    "topMessage",
    "noCatchesMessage",
    "infoMessage",
    "notCaughtMessage",
    "position",
    "critterSize",
    "showKeepers",
    "hintText",
    "mixedHintText",
    "wildLabel",
    "glimmerLabel",
    "caughtWord",
    "brokeFreeWord",
    "ranOffWord",
    "rarityNames",
    "jarNames",
    "timeZone"
  ],
  "sections": [
    {
      "id": "start",
      "title": "1. Turn on Critter Catch",
      "open": true,
      "fields": [
        "enabled",
        "platforms",
        "commandPlatforms",
        "catchCommand",
        "honeyWord",
        "moonWord"
      ],
      "notice": "Viewers type !catch to throw a Jar, !catch honey or !catch moon for a better one, !catch journal for their Field Journal and !catch top for this month's best Keepers. Moderators type !catch spawn, !catch end, !catch pause or !catch resume."
    },
    {
      "id": "critters",
      "title": "2. Critters",
      "fields": [
        "critterSet",
        "customCritters"
      ],
      "notice": "The 151 Village Critters are built in and drawn for the stream. Your own critters use the picture link you give them."
    },
    {
      "id": "jars",
      "title": "3. Jars and catching",
      "fields": [
        "jarCost",
        "honeyCost",
        "moonCost",
        "rewardThrows",
        "toggleRewards",
        "catchMode",
        "throwCooldownSeconds",
        "catchCap",
        "guardianCap"
      ],
      "notice": "Suggested Twitch and Kick rewards: \"Throw a Jar\" 500 points, \"Throw a Honey Jar\" 1,500, \"Throw a Moon Jar\" 4,000. Prompt: \"Throw a Jar at the critter on screen!\" Turn off Skip Reward Queue and add a 5 second cooldown. Create the Twitch rewards in Streamer.bot (Platforms > Twitch > Channel Point Rewards), not on the Twitch dashboard: Twitch only lets the app that made a reward turn it on, off or refund it."
    },
    {
      "id": "visits",
      "title": "4. Visits",
      "fields": [
        "spawnMinMinutes",
        "spawnMaxMinutes",
        "visitMode",
        "activeChatters",
        "activeMinutes",
        "onlyWhenChatting",
        "commonWeight",
        "uncommonWeight",
        "rareWeight",
        "guardianWeight",
        "guardianMonthlyLimit",
        "glimmerOdds"
      ],
      "notice": "Each critter visits one platform whose chat is active (two or more real chatters by default; you, your own accounts and bots do not count). When several chats are active, they take turns, oldest visit first, with the wait below between visits. Only that platform can throw Jars at it."
    },
    {
      "title": "5. How long critters stay",
      "notice": "Seconds each rarity stays on screen, and the chance it runs off after a missed throw.",
      "id": "stay",
      "fields": [
        "commonSeconds",
        "uncommonSeconds",
        "rareSeconds",
        "guardianSeconds",
        "commonFlee",
        "uncommonFlee",
        "rareFlee",
        "guardianFlee"
      ]
    },
    {
      "id": "chat",
      "title": "6. Chat messages",
      "fields": [
        "announceSpawns",
        "spawnMessage",
        "glimmerSpawnMessage",
        "rewardSpawnMessage",
        "caughtMessage",
        "glimmerCaughtMessage",
        "announceEntry",
        "entryMessage",
        "announceMisses",
        "missedMessage",
        "fledMessage",
        "announceLeaves"
      ]
    },
    {
      "title": "7. Command replies",
      "id": "replies",
      "fields": [
        "leftMessage",
        "noPointsMessage",
        "rewardOnlyMessage",
        "noCritterMessage",
        "journalMessage",
        "topMessage",
        "noCatchesMessage",
        "infoMessage",
        "notCaughtMessage"
      ],
      "notice": "What the bot says for !catch journal, top and info, or when a throw cannot happen."
    },
    {
      "id": "look",
      "title": "8. On stream",
      "fields": [
        "position",
        "critterSize",
        "showKeepers"
      ],
      "notice": "Add http://127.0.0.1:8787/overlay/addons/thsv.critter-catch as a 1920x1080 browser source (1080x1920 on a vertical canvas). On stream, critters show on their own, without scenery."
    },
    {
      "id": "words",
      "title": "9. Words on stream",
      "fields": [
        "hintText",
        "mixedHintText",
        "wildLabel",
        "glimmerLabel",
        "caughtWord",
        "brokeFreeWord",
        "ranOffWord",
        "rarityNames",
        "jarNames"
      ],
      "notice": "Change these to match your language or your community's style."
    },
    {
      "id": "stats",
      "title": "10. Monthly stats",
      "fields": [
        "timeZone"
      ],
      "notice": "Catches count per month and reset on the 1st; last month's top three Keepers move to the hall of fame. Field Journals never reset."
    }
  ],
  "fields": {
    "platforms": {
      "labels": {
        "twitch": "Twitch",
        "youtube": "YouTube",
        "kick": "Kick",
        "tiktok": "TikTok",
        "facebook": "Facebook"
      }
    },
    "critterSet": {
      "labels": {
        "village": "Village Critters (151)",
        "custom": "Only my own critters",
        "both": "Village Critters and my own"
      }
    },
    "customCritters": {
      "control": "row-list",
      "itemLabel": "critter",
      "columns": [
        {
          "label": "Name",
          "placeholder": "Mossling",
          "maxLength": 40,
          "width": "1fr",
          "required": true
        },
        {
          "label": "Rarity",
          "type": "select",
          "options": [
            {
              "value": "common",
              "label": "Common"
            },
            {
              "value": "uncommon",
              "label": "Uncommon"
            },
            {
              "value": "rare",
              "label": "Rare"
            },
            {
              "value": "guardian",
              "label": "Guardian"
            }
          ],
          "width": "8rem"
        },
        {
          "label": "Type",
          "placeholder": "Moss",
          "maxLength": 30,
          "width": "7rem"
        },
        {
          "label": "Picture link",
          "hint": "https link to a PNG, GIF or WebP",
          "placeholder": "https://",
          "maxLength": 600,
          "width": "1.4fr"
        },
        {
          "label": "Field Journal entry",
          "placeholder": "It naps in mossy hollows.",
          "maxLength": 300,
          "width": "1.6fr"
        }
      ]
    },
    "rewardThrows": {
      "control": "row-list",
      "itemLabel": "reward or gift",
      "columns": [
        {
          "label": "Reward ID or name",
          "hint": "Twitch/Kick reward ID, or the exact reward or gift name",
          "placeholder": "Throw a Jar",
          "maxLength": 100,
          "width": "1.4fr",
          "required": true
        },
        {
          "label": "Jar",
          "type": "select",
          "options": [
            {
              "value": "jar",
              "label": "Jar"
            },
            {
              "value": "honey",
              "label": "Honey Jar"
            },
            {
              "value": "moon",
              "label": "Moon Jar"
            }
          ],
          "width": "9rem"
        }
      ]
    },
    "catchMode": {
      "labels": {
        "everyone": "Everyone whose Jar lands",
        "first": "Only the first, then it leaves"
      }
    },
    "position": {
      "labels": {
        "top-left": "Top left",
        "top-center": "Top middle",
        "top-right": "Top right",
        "center-left": "Middle left",
        "center-right": "Middle right",
        "bottom-left": "Bottom left",
        "bottom-center": "Bottom middle",
        "bottom-right": "Bottom right"
      }
    },
    "critterSize": {
      "labels": {
        "small": "Small",
        "medium": "Medium",
        "large": "Large"
      }
    },
    "visitMode": {
      "labels": {
        "active-platform": "One active platform at a time (they take turns)",
        "everyone": "Every platform at once"
      }
    }
  }
}
