{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Village Fun Commands",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": { "type": "boolean", "title": "Enable Village Fun Commands", "default": false },
    "useOnlineProviders": { "type": "boolean", "title": "Use online providers when available", "default": true },
    "avoidRecentRepeats": { "type": "boolean", "title": "Avoid recent repeats", "default": true },
    "globalCooldownSeconds": { "type": "integer", "title": "Shared cooldown (seconds)", "minimum": 1, "maximum": 300, "default": 5 },
    "viewerCooldownSeconds": { "type": "integer", "title": "Per-viewer cooldown (seconds)", "minimum": 1, "maximum": 3600, "default": 20 },

    "slothFactEnabled": { "type": "boolean", "title": "Sloth facts", "default": true },
    "slothFactCommand": { "type": "string", "title": "Sloth fact command", "pattern": "^[a-z][a-z0-9-]{0,63}$", "default": "slothfact" },
    "catFactEnabled": { "type": "boolean", "title": "Cat facts", "default": true },
    "catFactCommand": { "type": "string", "title": "Cat fact command", "pattern": "^[a-z][a-z0-9-]{0,63}$", "default": "catfact" },
    "jokeEnabled": { "type": "boolean", "title": "Family-friendly jokes", "default": true },
    "jokeCommand": { "type": "string", "title": "Joke command", "pattern": "^[a-z][a-z0-9-]{0,63}$", "default": "joke" },
    "funFactEnabled": { "type": "boolean", "title": "Fun facts", "default": true },
    "funFactCommand": { "type": "string", "title": "Fun fact command", "pattern": "^[a-z][a-z0-9-]{0,63}$", "default": "funfact" },
    "numberFactEnabled": { "type": "boolean", "title": "Number facts", "default": true },
    "numberFactCommand": { "type": "string", "title": "Number fact command", "pattern": "^[a-z][a-z0-9-]{0,63}$", "default": "numberfact" },
    "eightBallEnabled": { "type": "boolean", "title": "Magic 8-Ball", "default": true },
    "eightBallCommand": { "type": "string", "title": "8-Ball command", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "default": "8ball" },
    "hugEnabled": { "type": "boolean", "title": "Hugs and hug leaderboard", "default": true },
    "hugCommand": { "type": "string", "title": "Hug command", "pattern": "^[a-z][a-z0-9-]{0,63}$", "default": "hug" },
    "hugsCommand": { "type": "string", "title": "Hug leaderboard command", "pattern": "^[a-z][a-z0-9-]{0,63}$", "default": "hugs" },
    "timezoneEnabled": { "type": "boolean", "title": "Streamer timezone and local time", "default": true },
    "timezoneCommand": { "type": "string", "title": "Timezone command", "pattern": "^[a-z][a-z0-9-]{0,63}$", "default": "timezone" },
    "timezoneName": { "type": "string", "title": "Streamer timezone", "minLength": 1, "maxLength": 64, "default": "America/Chicago", "description": "Use an IANA timezone such as America/Chicago, America/New_York, Europe/London, or Asia/Tokyo." },
    "timezoneLabel": { "type": "string", "title": "Timezone response label", "minLength": 1, "maxLength": 50, "default": "Streamer time" },
    "diceEnabled": { "type": "boolean", "title": "Dice rolls", "default": true },
    "diceCommand": { "type": "string", "title": "Dice command", "pattern": "^[a-z][a-z0-9-]{0,63}$", "default": "dice" },
    "pickEnabled": { "type": "boolean", "title": "Pick from a list", "default": true },
    "pickCommand": { "type": "string", "title": "Pick command", "pattern": "^[a-z][a-z0-9-]{0,63}$", "default": "pick" },
    "rateEnabled": { "type": "boolean", "title": "Playful ratings", "default": true },
    "rateCommand": { "type": "string", "title": "Rate command", "pattern": "^[a-z][a-z0-9-]{0,63}$", "default": "rate" },
    "randomColorEnabled": { "type": "boolean", "title": "Random colors", "default": true },
    "randomColorCommand": { "type": "string", "title": "Random color command", "pattern": "^[a-z][a-z0-9-]{0,63}$", "default": "randomcolor" },
    "followAgeEnabled": { "type": "boolean", "title": "Twitch follow age", "default": true, "description": "Twitch-only self lookup using the broadcaster connection held by Streamer.bot." },
    "followAgeCommand": { "type": "string", "title": "Follow age command", "pattern": "^[a-z][a-z0-9-]{0,63}$", "default": "followage" },

    "chuckNorrisEnabled": { "type": "boolean", "title": "Chuck Norris jokes", "default": false },
    "chuckNorrisCommand": { "type": "string", "title": "Chuck Norris command", "pattern": "^[a-z][a-z0-9-]{0,63}$", "default": "chucknorris" },
    "aestheticEnabled": { "type": "boolean", "title": "Aesthetic text", "default": false },
    "aestheticCommand": { "type": "string", "title": "Aesthetic command", "pattern": "^[a-z][a-z0-9-]{0,63}$", "default": "aesthetic" },

    "additionalSlothFacts": { "type": "array", "title": "Additional sloth facts", "items": { "type": "string", "minLength": 1, "maxLength": 350 }, "maxItems": 50, "uniqueItems": true, "default": [] },
    "additionalCatFacts": { "type": "array", "title": "Additional cat facts", "items": { "type": "string", "minLength": 1, "maxLength": 350 }, "maxItems": 50, "uniqueItems": true, "default": [] },
    "additionalJokes": { "type": "array", "title": "Additional family-friendly jokes", "items": { "type": "string", "minLength": 1, "maxLength": 350 }, "maxItems": 50, "uniqueItems": true, "default": [] },
    "additionalFunFacts": { "type": "array", "title": "Additional fun facts", "items": { "type": "string", "minLength": 1, "maxLength": 350 }, "maxItems": 50, "uniqueItems": true, "default": [] },
    "additionalNumberFacts": { "type": "array", "title": "Additional number facts", "items": { "type": "string", "minLength": 1, "maxLength": 350 }, "maxItems": 50, "uniqueItems": true, "default": [] },
    "additionalChuckNorrisJokes": { "type": "array", "title": "Additional Chuck Norris jokes", "items": { "type": "string", "minLength": 1, "maxLength": 350 }, "maxItems": 50, "uniqueItems": true, "default": [] }
  }
}
