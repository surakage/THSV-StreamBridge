{
  "packageFormat": "thsv-addon-v2",
  "packageKind": "executable",
  "author": "THSV StreamBridge",
  "description": "Routes selected alerts and cross-platform viewer TTS requests through one bounded Speaker.bot queue with an optional avatar and progressive-text overlay.",
  "changelog": "4.1.3: aligned with THSV StreamBridge 4.1.3, guided wizard UI, verified update metadata, and regenerated Streamer.bot imports. 2.4.2: initial safe rebuild with alert-first allowlist, role-gated chat, local filtering, bounded queue, link stripping, and creator pause/resume/stop controls.",
  "permissions": [
    "events.subscribe",
    "streamerbot.run-approved-action",
    "schedule.bounded",
    "overlay.publish",
    "chat.send",
    "viewer.foundation.read",
    "viewer.foundation.mutate"
  ],
  "trust": {
