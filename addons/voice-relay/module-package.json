{
  "packageFormat": "thsv-addon-v2",
  "packageKind": "executable",
  "author": "THSV StreamBridge",
  "description": "Sends chosen alerts and viewer TTS requests from every platform through one Speaker.bot queue, with an optional avatar and an overlay that shows the words as they are spoken.",
  "changelog": "4.1.7: aligned with THSV StreamBridge 4.1.7, guided wizard UI, verified update metadata, and regenerated Streamer.bot imports. 2.4.2: initial safe rebuild with alert-first allowlist, role-gated chat, local filtering, bounded queue, link stripping, and creator pause/resume/stop controls.",
  "permissions": [
    "events.subscribe",
    "streamerbot.run-approved-action",
    "schedule.bounded",
    "overlay.publish",
    "chat.send",
    "viewer.foundation.read",
    "viewer.foundation.mutate"
  ],
  "trust": {
    "publisherId": "thsv.streambridge",
    "sourceUrl": "https://github.com/surakage/THSV-StreamBridge",
    "supportUrl": "https://www.slothbloom.com/tip",
    "updateManifestUrl": "https://github.com/surakage/THSV-StreamBridge/releases",
    "revocationListUrl": "https://github.com/surakage/THSV-StreamBridge/security/advisories"
  },
  "manifest": {
