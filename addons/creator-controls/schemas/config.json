{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Creator Controls",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": { "type": "boolean", "title": "Enable Creator Controls", "default": false },
    "allowSimulatedControls": { "type": "boolean", "title": "Allow Streamer.bot Test triggers to apply profiles", "description": "Keep this off after setup so a Trigger Test cannot alter live channel metadata.", "default": false },
    "profile1Enabled": { "type": "boolean", "title": "Enable profile 1", "default": true },
    "profile1Name": { "type": "string", "title": "Profile 1 name", "minLength": 1, "maxLength": 80, "default": "Starting Soon" },
    "profile1Platforms": { "type": "array", "title": "Profile 1 platforms", "items": { "type": "string", "enum": ["twitch", "youtube", "kick"] }, "maxItems": 3, "uniqueItems": true, "default": ["twitch", "youtube", "kick"] },
    "profile1Title": { "type": "string", "title": "Profile 1 channel title", "maxLength": 100, "default": "Starting soon — welcome in!" },
    "profile1TwitchCategoryId": { "type": "string", "title": "Profile 1 Twitch category ID", "pattern": "^[0-9]{0,20}$", "maxLength": 20, "default": "" },
    "profile1YoutubeCategoryName": { "type": "string", "title": "Profile 1 YouTube category name", "maxLength": 100, "default": "Gaming" },
    "profile1YoutubeBroadcastId": { "type": "string", "title": "Profile 1 YouTube broadcast ID (optional)", "maxLength": 128, "default": "" },
    "profile1KickCategoryName": { "type": "string", "title": "Profile 1 Kick category name", "maxLength": 100, "default": "Just Chatting" },
    "profile2Enabled": { "type": "boolean", "title": "Enable profile 2", "default": true },
    "profile2Name": { "type": "string", "title": "Profile 2 name", "minLength": 1, "maxLength": 80, "default": "Gameplay" },
    "profile2Platforms": { "type": "array", "title": "Profile 2 platforms", "items": { "type": "string", "enum": ["twitch", "youtube", "kick"] }, "maxItems": 3, "uniqueItems": true, "default": ["twitch", "youtube", "kick"] },
    "profile2Title": { "type": "string", "title": "Profile 2 channel title", "maxLength": 100, "default": "Live gameplay with the community" },
    "profile2TwitchCategoryId": { "type": "string", "title": "Profile 2 Twitch category ID", "pattern": "^[0-9]{0,20}$", "maxLength": 20, "default": "" },
    "profile2YoutubeCategoryName": { "type": "string", "title": "Profile 2 YouTube category name", "maxLength": 100, "default": "Gaming" },
    "profile2YoutubeBroadcastId": { "type": "string", "title": "Profile 2 YouTube broadcast ID (optional)", "maxLength": 128, "default": "" },
    "profile2KickCategoryName": { "type": "string", "title": "Profile 2 Kick category name", "maxLength": 100, "default": "" },
    "profile3Enabled": { "type": "boolean", "title": "Enable profile 3", "default": true },
    "profile3Name": { "type": "string", "title": "Profile 3 name", "minLength": 1, "maxLength": 80, "default": "Just Chatting" },
    "profile3Platforms": { "type": "array", "title": "Profile 3 platforms", "items": { "type": "string", "enum": ["twitch", "youtube", "kick"] }, "maxItems": 3, "uniqueItems": true, "default": ["twitch", "youtube", "kick"] },
    "profile3Title": { "type": "string", "title": "Profile 3 channel title", "maxLength": 100, "default": "Hanging out with chat" },
    "profile3TwitchCategoryId": { "type": "string", "title": "Profile 3 Twitch category ID", "pattern": "^[0-9]{0,20}$", "maxLength": 20, "default": "509658" },
    "profile3YoutubeCategoryName": { "type": "string", "title": "Profile 3 YouTube category name", "maxLength": 100, "default": "Entertainment" },
    "profile3YoutubeBroadcastId": { "type": "string", "title": "Profile 3 YouTube broadcast ID (optional)", "maxLength": 128, "default": "" },
    "profile3KickCategoryName": { "type": "string", "title": "Profile 3 Kick category name", "maxLength": 100, "default": "Just Chatting" }
  }
}
