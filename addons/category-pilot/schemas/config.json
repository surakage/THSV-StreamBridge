    "mapping2Enabled": { "type": "boolean", "title": "Enable mapping 2", "default": false }, "mapping2ProcessName": { "type": "string", "title": "Mapping 2 process name", "pattern": "^[A-Za-z0-9._ -]{0,100}$", "maxLength": 100, "default": "" }, "mapping2Profile": { "type": "string", "title": "Mapping 2 profile", "enum": ["profile-1", "profile-2", "profile-3"], "default": "profile-2" },
    "mapping3Enabled": { "type": "boolean", "title": "Enable mapping 3", "default": false }, "mapping3ProcessName": { "type": "string", "title": "Mapping 3 process name", "pattern": "^[A-Za-z0-9._ -]{0,100}$", "maxLength": 100, "default": "" }, "mapping3Profile": { "type": "string", "title": "Mapping 3 profile", "enum": ["profile-1", "profile-2", "profile-3"], "default": "profile-2" },
    "mapping4Enabled": { "type": "boolean", "title": "Enable mapping 4", "default": false }, "mapping4ProcessName": { "type": "string", "title": "Mapping 4 process name", "pattern": "^[A-Za-z0-9._ -]{0,100}$", "maxLength": 100, "default": "" }, "mapping4Profile": { "type": "string", "title": "Mapping 4 profile", "enum": ["profile-1", "profile-2", "profile-3"], "default": "profile-2" },
    "mapping5Enabled": { "type": "boolean", "title": "Enable mapping 5", "default": false }, "mapping5ProcessName": { "type": "string", "title": "Mapping 5 process name", "pattern": "^[A-Za-z0-9._ -]{0,100}$", "maxLength": 100, "default": "" }, "mapping5Profile": { "type": "string", "title": "Mapping 5 profile", "enum": ["profile-1", "profile-2", "profile-3"], "default": "profile-2" },
    "xboxEnabled": { "type": "boolean", "title": "Detect Xbox games", "description": "Asks Xbox (through OpenXBL) which game you are playing. Save your OpenXBL API key below first.", "default": false },
    "playstationEnabled": { "type": "boolean", "title": "Detect PlayStation games", "description": "Asks PlayStation which game you are playing. Unofficial: it may stop working. Save your NPSSO below first.", "default": false },
    "console1Enabled": { "type": "boolean", "title": "Use console game 1", "default": true }, "console1Platform": { "type": "string", "title": "Console", "enum": ["any", "xbox", "playstation"], "default": "any" }, "console1TitleName": { "type": "string", "title": "Game name", "description": "The game name as Xbox or PlayStation shows it. Case does not matter.", "maxLength": 100, "default": "" }, "console1Profile": { "type": "string", "title": "Use this profile", "enum": ["profile-1", "profile-2", "profile-3"], "default": "profile-2" },
    "console2Enabled": { "type": "boolean", "title": "Use console game 2", "default": false }, "console2Platform": { "type": "string", "title": "Console", "enum": ["any", "xbox", "playstation"], "default": "any" }, "console2TitleName": { "type": "string", "title": "Game name", "description": "The game name as Xbox or PlayStation shows it. Case does not matter.", "maxLength": 100, "default": "" }, "console2Profile": { "type": "string", "title": "Use this profile", "enum": ["profile-1", "profile-2", "profile-3"], "default": "profile-2" },
