    "console4Enabled": { "type": "boolean", "title": "Use console game 4", "default": false }, "console4Platform": { "type": "string", "title": "Console", "enum": ["any", "xbox", "playstation"], "default": "any" }, "console4TitleName": { "type": "string", "title": "Game name", "description": "The game name as Xbox or PlayStation shows it. Case does not matter.", "maxLength": 100, "default": "" }, "console4Profile": { "type": "string", "title": "Use this profile", "enum": ["profile-1", "profile-2", "profile-3"], "default": "profile-2" },
    "console5Enabled": { "type": "boolean", "title": "Use console game 5", "default": false }, "console5Platform": { "type": "string", "title": "Console", "enum": ["any", "xbox", "playstation"], "default": "any" }, "console5TitleName": { "type": "string", "title": "Game name", "description": "The game name as Xbox or PlayStation shows it. Case does not matter.", "maxLength": 100, "default": "" }, "console5Profile": { "type": "string", "title": "Use this profile", "enum": ["profile-1", "profile-2", "profile-3"], "default": "profile-2" }
