{
  "intro": "Viewers spend points on short screen effects or on exercises you do on camera. Effects run one at a time. Exercises get a countdown, then StreamBridge switches to a safe scene until you or a mod mark them done.",
  "order": [
    "enabled",
    "effects",
    "exercises",
    "buyCommand",
    "buyPlatforms",
    "doneCommand",
    "statusCommand",
    "controlCommand",
    "graceSeconds",
    "safeSceneName",
    "returnToPreviousScene",
    "connectionIndex",
    "maximumPerStream",
    "exerciseCooldownMinutes",
    "effectCooldownSeconds",
    "effectGapSeconds",
    "maximumEffectQueue",
    "onlyWhileLive",
    "showOverlay",
    "trackerEnabled",
    "trackerOnlyWhileOwed",
    "trackerPosition",
    "chatReplies",
    "effectMessage",
    "exerciseMessage",
    "startMessage",
    "doneMessage",
    "limitMessage",
    "cooldownMessage",
    "pointsMessage",
    "listMessage",
    "beanEnabled",
    "beanPairs",
    "beanBitsPerSpin",
    "beanCoinsPerSpin",
    "beanTipPerSpin",
    "beanTipCurrency",
    "beanMaximumSpins",
    "beanSpinSeconds",
    "beanSpinMessage",
    "beanDoneMessage"
  ],
  "sections": [
    {
      "id": "items",
      "title": "1. Punishments",
      "description": "Screen effects and exercises viewers can buy.",
      "open": true,
      "fields": [
        "enabled",
        "effects",
        "exercises"
      ],
      "notice": "Screen effects: in OBS, add a filter to the source (for example a Color Correction filter named THSV Blackout with brightness turned down), turn it off, and type the exact source and filter names here. Pixelate needs the Composite Blur plugin and Barrel roll needs the Move plugin. Prices are StreamBridge points. For Twitch and Kick, create channel point rewards with their own prices and paste each reward ID into its Twitch or Kick box (right-click the reward in Streamer.bot and choose Copy Reward Id). Kick rewards have no limit or cooldown of their own, so StreamBridge enforces the exercise limit and cooldowns below for Kick. Leave Redemption Skips Queue off on Kick rewards so a blocked redemption can be rejected from the Kick queue."
    },
    {
      "id": "exercise-flow",
      "title": "2. Exercises",
      "description": "Grace period, safe scene, and limits.",
      "open": true,
      "fields": [
        "graceSeconds",
        "safeSceneName",
        "returnToPreviousScene",
        "maximumPerStream",
        "exerciseCooldownMinutes"
      ],
      "notice": "Exercises bought during Starting Soon, a break, or the ending wait until you are back on a normal scene. Monthly totals reset at your first stream in a new month."
    },
    {
      "id": "commands",
      "title": "3. Commands",
      "description": "Restart StreamBridge after changing commands.",
      "fields": [
        "buyCommand",
        "buyPlatforms",
        "doneCommand",
        "statusCommand",
        "controlCommand"
      ]
    },
    {
      "id": "effects-timing",
      "title": "4. Screen effect timing",
      "fields": [
        "effectCooldownSeconds",
        "effectGapSeconds",
        "maximumEffectQueue",
        "onlyWhileLive",
        "showOverlay",
        "trackerEnabled",
        "trackerOnlyWhileOwed",
        "trackerPosition",
        "connectionIndex"
      ]
    },
    {
      "id": "bean-boozled",
      "title": "5. Bean Boozled wheel",
      "description": "Bits, TikTok gifts, and tips spin a wheel of bean colors, then reveal nice or NASTY.",
      "fields": [
        "beanEnabled",
        "beanPairs",
        "beanBitsPerSpin",
        "beanCoinsPerSpin",
        "beanTipPerSpin",
        "beanTipCurrency",
        "beanMaximumSpins",
        "beanSpinSeconds",
        "beanSpinMessage",
        "beanDoneMessage"
      ],
      "notice": "The wheel shows on the Streamer Punishments overlay. The bean goes on the owed list: the countdown runs, StreamBridge switches to your safe scene, and you or a mod type !done once it is eaten. Moderators can type !punish bean for a test spin."
    },
    {
      "id": "messages",
      "title": "6. Chat replies",
      "description": "Optional messages sent back to chat.",
      "fields": [
        "chatReplies",
        "effectMessage",
        "exerciseMessage",
        "startMessage",
        "doneMessage",
        "limitMessage",
        "cooldownMessage",
        "pointsMessage",
        "listMessage"
      ]
    }
  ],
  "fields": {
    "effects": {
      "control": "row-list",
      "itemLabel": "effect",
      "columns": [
        {
          "label": "Name",
          "hint": "!buy name",
          "placeholder": "Blackout",
          "maxLength": 40,
          "width": "1fr",
          "required": true
        },
        {
          "label": "OBS source",
          "hint": "Exact source name",
          "placeholder": "Elgato capture",
          "maxLength": 256,
          "width": "1.3fr"
        },
        {
          "label": "OBS filter",
          "hint": "Exact filter name",
          "placeholder": "THSV Blackout",
          "maxLength": 256,
          "width": "1.3fr"
        },
        {
          "label": "Seconds",
          "hint": "3 to 120",
          "placeholder": "15",
          "type": "number",
          "min": 3,
          "max": 120,
          "width": "6rem"
        },
        {
          "label": "Points",
          "hint": "StreamBridge points",
          "placeholder": "100",
          "type": "number",
          "min": 0,
          "max": 1000000,
          "width": "7rem"
        },
        {
          "label": "Twitch reward ID",
          "hint": "Optional",
          "placeholder": "Twitch ID",
          "maxLength": 300,
          "width": "1.3fr"
        },
        {
          "label": "Kick reward ID",
          "hint": "Optional",
          "placeholder": "Kick ID",
          "maxLength": 300,
          "width": "1.3fr"
        }
      ]
    },
    "exercises": {
      "control": "row-list",
      "itemLabel": "exercise",
      "columns": [
        {
          "label": "Name",
          "hint": "!buy name",
          "placeholder": "Pushups",
          "maxLength": 40,
          "width": "1fr",
          "required": true
        },
        {
          "label": "Reps",
          "hint": "Per purchase",
          "placeholder": "10",
          "type": "number",
          "min": 1,
          "max": 500,
          "width": "6rem"
        },
        {
          "label": "Points",
          "hint": "StreamBridge points",
          "placeholder": "250",
          "type": "number",
          "min": 0,
          "max": 1000000,
          "width": "7rem"
        },
        {
          "label": "Twitch reward ID",
          "hint": "Optional",
          "placeholder": "Twitch ID",
          "maxLength": 300,
          "width": "1.3fr"
        },
        {
          "label": "Kick reward ID",
          "hint": "Optional",
          "placeholder": "Kick ID",
          "maxLength": 300,
          "width": "1.3fr"
        }
      ]
    },
    "safeSceneName": {
      "control": "scene-name"
    },
    "effectMessage": {
      "visibleWhen": {
        "field": "chatReplies",
        "equals": true
      }
    },
    "exerciseMessage": {
      "visibleWhen": {
        "field": "chatReplies",
        "equals": true
      }
    },
    "startMessage": {
      "visibleWhen": {
        "field": "chatReplies",
        "equals": true
      }
    },
    "doneMessage": {
      "visibleWhen": {
        "field": "chatReplies",
        "equals": true
      }
    },
    "limitMessage": {
      "visibleWhen": {
        "field": "chatReplies",
        "equals": true
      }
    },
    "cooldownMessage": {
      "visibleWhen": {
        "field": "chatReplies",
        "equals": true
      }
    },
    "pointsMessage": {
      "visibleWhen": {
        "field": "chatReplies",
        "equals": true
      }
    },
    "listMessage": {
      "visibleWhen": {
        "field": "chatReplies",
        "equals": true
      }
    },
    "beanPairs": {
      "control": "row-list",
      "itemLabel": "bean",
      "columns": [
        {
          "label": "Color",
          "hint": "Shown on the wheel",
          "placeholder": "Black",
          "maxLength": 24,
          "width": "1fr",
          "required": true
        },
        {
          "label": "Wheel color",
          "hint": "#hex",
          "placeholder": "#1c1c1c",
          "maxLength": 7,
          "width": "7rem"
        },
        {
          "label": "Nice flavor",
          "hint": "Good bean",
          "placeholder": "Licorice",
          "maxLength": 40,
          "width": "1.2fr",
          "required": true
        },
        {
          "label": "Nasty flavor",
          "hint": "Bad bean",
          "placeholder": "Burnt Rubber",
          "maxLength": 40,
          "width": "1.2fr",
          "required": true
        }
      ],
      "visibleWhen": {
        "field": "beanEnabled",
        "equals": true
      }
    },
    "beanBitsPerSpin": {
      "visibleWhen": {
        "field": "beanEnabled",
        "equals": true
      }
    },
    "trackerEnabled": {
      "visibleWhen": {
        "field": "showOverlay",
        "equals": true
      }
    },
    "trackerPosition": {
      "visibleWhen": {
        "field": "trackerEnabled",
        "equals": true
      },
      "labels": {
        "top-left": "Top left",
        "top-right": "Top right",
        "bottom-left": "Bottom left",
        "bottom-right": "Bottom right"
      }
    },
    "beanCoinsPerSpin": {
      "visibleWhen": {
        "field": "beanEnabled",
        "equals": true
      }
    },
    "beanTipPerSpin": {
      "visibleWhen": {
        "field": "beanEnabled",
        "equals": true
      }
    },
    "beanTipCurrency": {
      "visibleWhen": {
        "field": "beanEnabled",
        "equals": true
      }
    },
    "beanMaximumSpins": {
      "visibleWhen": {
        "field": "beanEnabled",
        "equals": true
      }
    },
    "beanSpinSeconds": {
      "visibleWhen": {
        "field": "beanEnabled",
        "equals": true
      }
    },
    "beanSpinMessage": {
      "visibleWhen": {
        "field": "beanEnabled",
        "equals": true
      }
    },
    "beanDoneMessage": {
      "visibleWhen": {
        "field": "beanEnabled",
        "equals": true
      }
    },
    "trackerOnlyWhileOwed": {
      "visibleWhen": {
        "field": "trackerEnabled",
        "equals": true
      }
    }
  }
}
