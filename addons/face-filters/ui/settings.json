{
  "intro": "Let chat put Streamfog face lenses on your camera with a command or a channel point reward. One lens shows at a time; extra requests wait in a short line.",
  "order": [
    "enabled",
    "lenses",
    "filterCommand",
    "allowRandom",
    "commandPlatforms",
    "commandRole",
    "defaultDurationSeconds",
    "gapSeconds",
    "globalCooldownSeconds",
    "viewerCooldownSeconds",
    "maximumQueue",
    "onlyWhileLive",
    "chatReplies",
    "startedMessage",
    "queuedMessage",
    "cooldownMessage",
    "unknownMessage"
  ],
  "sections": [
    {
      "id": "quick-start",
      "title": "1. Lenses",
      "description": "Add, remove, or rename lenses. Each line is one lens.",
      "open": true,
      "fields": [
        "enabled",
        "lenses"
      ],
      "notice": "Each row is one lens. Type the lens name exactly as Streamfog shows it. Fill in a chat command, reward IDs, or both; leave a box empty to skip it. Reward IDs never change when you rename a reward: in Streamer.bot, right-click the reward and choose Copy Reward Id. Voicemod voice (optional): pick the voice in Voicemod, then a moderator types !filter voice and StreamBridge replies with its ID to paste here; the voice changer turns on with the lens and off when it ends. Restart StreamBridge after changing commands."
    },
    {
      "id": "commands",
      "title": "2. Who can trigger lenses",
      "description": "Commands work on every selected chat; channel point rewards work on Twitch and Kick.",
      "open": true,
      "fields": [
        "filterCommand",
        "allowRandom",
        "commandPlatforms",
        "commandRole"
      ]
    },
    {
      "id": "timing",
      "title": "3. Timing and limits",
      "description": "Keep lenses short and spaced out so chat cannot spam your camera.",
      "fields": [
        "defaultDurationSeconds",
        "gapSeconds",
        "globalCooldownSeconds",
        "viewerCooldownSeconds",
        "maximumQueue",
        "onlyWhileLive"
      ],
      "notice": "Channel point redemptions, moderators, and you skip cooldowns but still wait in line."
    },
    {
      "id": "messages",
      "title": "4. Chat replies",
      "description": "Optional confirmations sent back to the chat that asked.",
      "fields": [
        "chatReplies",
        "startedMessage",
        "queuedMessage",
        "cooldownMessage",
        "unknownMessage"
      ]
    }
  ],
  "fields": {
    "lenses": {
      "control": "row-list",
      "itemLabel": "lens",
      "columns": [
        {
          "label": "Name",
          "hint": "Shown in chat",
          "placeholder": "Banana",
          "maxLength": 40,
          "width": "1fr",
          "required": true
        },
        {
          "label": "Streamfog lens",
          "hint": "Exact name in Streamfog",
          "placeholder": "Streamfog name",
          "maxLength": 100,
          "width": "1.3fr"
        },
        {
          "label": "Chat command",
          "hint": "Optional",
          "placeholder": "!command",
          "maxLength": 65,
          "width": "1fr"
        },
        {
          "label": "Twitch reward ID",
          "hint": "Optional",
          "placeholder": "Twitch ID",
          "maxLength": 300,
          "width": "1.2fr"
        },
        {
          "label": "Kick reward ID",
          "hint": "Optional",
          "placeholder": "Kick ID",
          "maxLength": 300,
          "width": "1.2fr"
        },
        {
          "label": "Seconds",
          "hint": "5 to 600",
          "placeholder": "30",
          "type": "number",
          "min": 5,
          "max": 600,
          "width": "6rem"
        },
        {
          "label": "Voicemod voice ID",
          "hint": "Optional: !filter voice",
          "placeholder": "Voice ID",
          "maxLength": 120,
          "width": "1.2fr"
        }
      ],
      "legacyColumnOrder": [
        0,
        1,
        2,
        3,
        5
      ]
    },
    "commandRole": {
      "labels": {
        "viewer": "Everyone",
        "subscriber": "Subscribers and members",
        "moderator": "Moderators",
        "broadcaster": "Only me"
      }
    },
    "startedMessage": {
      "visibleWhen": {
        "field": "chatReplies",
        "equals": true
      }
    },
    "queuedMessage": {
      "visibleWhen": {
        "field": "chatReplies",
        "equals": true
      }
    },
    "cooldownMessage": {
      "visibleWhen": {
        "field": "chatReplies",
        "equals": true
      }
    },
    "unknownMessage": {
      "visibleWhen": {
        "field": "chatReplies",
        "equals": true
      }
    }
  }
}
