{
  "intro": "Start with Quick start, then open only the behavior you want to customize. Automatic and manual shoutouts remain disabled until you enable them.",
  "order": [
    "enabled", "enabledPlatforms", "triggerOnRaids", "minimumRaidViewers",
    "triggerOnFirstChat", "firstChatAudience", "firstChatAllowlist", "welcomeTimeZone", "welcomeSafetyMode", "welcomeDelaySeconds", "welcomeRequireStableId", "welcomeRejectLinks", "welcomeBlockedTerms", "welcomeBlockedDomains", "triggerOnManualCommand", "manualCommandName",
    "ignoreConnectedAccounts", "ignoredUsers", "deliveryMode", "selectedPlatforms", "raidTemplate", "twitchFirstChatTemplate", "twitchViewerWelcomeTemplate", "twitchViewerWelcomeAlternates",
    "youtubeWelcomeTemplate", "youtubeWelcomeAlternates", "kickWelcomeTemplate", "kickWelcomeAlternates", "tiktokWelcomeTemplate", "tiktokWelcomeAlternates", "manualTwitchTemplate",
    "manualChannelTemplate", "globalCooldownSeconds", "userCooldownMinutes", "onePerStream",
    "maximumQueueSize", "queueExpiryMinutes", "twitchShoutoutMode", "showOverlayCard", "overlayPlatforms", "twitchVisualTriggers",
    "overlayCardTemplate", "overlayDurationSeconds", "firstChatResetHours", "twitchVisualType", "clipCount", "clipMaximumAgeDays", "clipMaximumDurationSeconds", "clipPreferPopular", "clipMuted", "clipVolume", "clipFallbackToCard"
  ],
  "sections": [
    {
      "id": "quick-start",
      "title": "1. Quick start",
      "description": "Turn the add-on on and choose which platforms it watches.",
      "open": true,
      "fields": ["enabled", "enabledPlatforms"]
    },
    {
      "id": "automatic",
      "title": "2. Automatic shoutouts",
      "description": "Choose raids and safe once-per-day viewer welcomes. Daily identity follows the configured timezone, not each stream restart.",
      "fields": ["triggerOnRaids", "minimumRaidViewers", "triggerOnFirstChat", "firstChatAudience", "firstChatAllowlist", "welcomeTimeZone", "ignoreConnectedAccounts"]
    },
    {
      "id": "manual",
      "title": "3. Manual moderator command",
      "description": "Configure the command moderators use when they choose a shoutout target.",
      "fields": ["triggerOnManualCommand", "manualCommandName"]
    },
    {
      "id": "delivery",
      "title": "4. Message destinations",
      "description": "Choose where text is posted and whether Twitch also receives its native shoutout.",
      "fields": ["deliveryMode", "selectedPlatforms", "twitchShoutoutMode"]
    },
    {
      "id": "twitch-messages",
      "title": "5. Twitch messages",
      "description": "Edit raid, creator, randomized viewer-welcome, and manual Twitch wording.",
      "fields": ["raidTemplate", "twitchFirstChatTemplate", "twitchViewerWelcomeTemplate", "twitchViewerWelcomeAlternates", "manualTwitchTemplate"]
    },
    {
      "id": "other-messages",
      "title": "6. YouTube, Kick, and TikTok messages",
      "description": "Edit platform welcomes and the manual channel-link message.",
      "fields": ["youtubeWelcomeTemplate", "youtubeWelcomeAlternates", "kickWelcomeTemplate", "kickWelcomeAlternates", "tiktokWelcomeTemplate", "tiktokWelcomeAlternates", "manualChannelTemplate"]
    },
    {
      "id": "safety",
      "title": "7. Welcome safety and ignored users",
      "description": "Balanced is preconfigured with connected-account blocking, known service bots, promotion phrases, blocked domains, stable-ID checks, and a short review delay. Every list remains editable.",
      "fields": ["welcomeSafetyMode", "welcomeDelaySeconds", "welcomeRequireStableId", "welcomeRejectLinks", "welcomeBlockedTerms", "welcomeBlockedDomains", "ignoredUsers", "globalCooldownSeconds", "userCooldownMinutes", "onePerStream", "maximumQueueSize", "queueExpiryMinutes"]
    },
    {
      "id": "overlay",
      "title": "8. Platform-colored visual cards",
      "description": "Twitch can show a verified Streamer card or a Viewer welcome. YouTube, Kick, and TikTok use color-coded Viewer welcomes because their chatter category cannot be verified. No clips are retrieved or played.",
      "fields": ["showOverlayCard", "overlayPlatforms", "twitchVisualTriggers", "overlayCardTemplate", "overlayDurationSeconds"]
    },
    {
      "id": "retired-compatibility",
      "title": "Retired compatibility settings",
      "description": "Hidden compatibility values preserve older installations and have no runtime effect.",
      "fields": ["firstChatResetHours", "twitchVisualType", "clipCount", "clipMaximumAgeDays", "clipMaximumDurationSeconds", "clipPreferPopular", "clipMuted", "clipVolume", "clipFallbackToCard"]
    }
  ],
  "fields": {
    "minimumRaidViewers": { "visibleWhen": { "field": "triggerOnRaids", "equals": true } },
    "firstChatAudience": { "visibleWhen": { "field": "triggerOnFirstChat", "equals": true }, "labels": { "safe-all": "Every safety-approved viewer", "allowlist-only": "Only safety-approved viewers on my allowlist" } },
    "firstChatAllowlist": { "visibleWhen": { "field": "firstChatAudience", "equals": "allowlist-only" }, "rows": 4 },
    "welcomeTimeZone": { "visibleWhen": { "field": "triggerOnFirstChat", "equals": true } },
    "welcomeSafetyMode": { "visibleWhen": { "field": "triggerOnFirstChat", "equals": true }, "labels": { "balanced": "Balanced (recommended)", "strict": "Strict", "open": "Open (explicit blocks still apply)" } },
    "welcomeDelaySeconds": { "visibleWhen": { "field": "triggerOnFirstChat", "equals": true } },
    "welcomeRequireStableId": { "visibleWhen": { "field": "triggerOnFirstChat", "equals": true } },
    "welcomeRejectLinks": { "visibleWhen": { "field": "triggerOnFirstChat", "equals": true } },
    "welcomeBlockedTerms": { "visibleWhen": { "field": "triggerOnFirstChat", "equals": true }, "rows": 5 },
    "welcomeBlockedDomains": { "visibleWhen": { "field": "triggerOnFirstChat", "equals": true }, "rows": 4 },
    "manualCommandName": { "visibleWhen": { "field": "triggerOnManualCommand", "equals": true } },
    "selectedPlatforms": { "visibleWhen": { "field": "deliveryMode", "equals": "selected" } },
    "deliveryMode": { "labels": { "source": "Reply only on the source platform", "selected": "Post to selected platforms" } },
    "twitchShoutoutMode": { "labels": { "text": "Editable text only", "native": "Native Twitch shoutout only", "both": "Native shoutout and editable text" } },
    "overlayPlatforms": { "visibleWhen": { "field": "showOverlayCard", "equals": true } },
    "twitchVisualTriggers": { "visibleWhen": { "field": "showOverlayCard", "equals": true }, "labels": { "raid": "Incoming Twitch raids", "first-chat": "Safety-approved daily welcomes", "manual": "Manual moderator shoutouts" } },
    "raidTemplate": { "visibleWhen": { "field": "triggerOnRaids", "equals": true }, "rows": 3 },
    "twitchFirstChatTemplate": { "visibleWhen": { "field": "triggerOnFirstChat", "equals": true }, "rows": 3 },
    "twitchViewerWelcomeTemplate": { "visibleWhen": { "field": "triggerOnFirstChat", "equals": true }, "rows": 3 },
    "twitchViewerWelcomeAlternates": { "visibleWhen": { "field": "triggerOnFirstChat", "equals": true }, "rows": 5 },
    "youtubeWelcomeTemplate": { "visibleWhen": { "field": "triggerOnFirstChat", "equals": true }, "rows": 3 },
    "youtubeWelcomeAlternates": { "visibleWhen": { "field": "triggerOnFirstChat", "equals": true }, "rows": 5 },
    "kickWelcomeTemplate": { "visibleWhen": { "field": "triggerOnFirstChat", "equals": true }, "rows": 3 },
    "kickWelcomeAlternates": { "visibleWhen": { "field": "triggerOnFirstChat", "equals": true }, "rows": 5 },
    "tiktokWelcomeTemplate": { "visibleWhen": { "field": "triggerOnFirstChat", "equals": true }, "rows": 3 },
    "tiktokWelcomeAlternates": { "visibleWhen": { "field": "triggerOnFirstChat", "equals": true }, "rows": 5 },
    "manualTwitchTemplate": { "visibleWhen": { "field": "triggerOnManualCommand", "equals": true }, "rows": 3 },
    "manualChannelTemplate": { "visibleWhen": { "field": "triggerOnManualCommand", "equals": true }, "rows": 3 },
    "ignoredUsers": { "rows": 4 },
    "overlayCardTemplate": { "visibleWhen": { "field": "showOverlayCard", "equals": true }, "rows": 3 },
    "overlayDurationSeconds": { "visibleWhen": { "field": "showOverlayCard", "equals": true } }
    ,"firstChatResetHours": { "visibleWhen": { "field": "enabled", "equals": "__retired__" } }
    ,"twitchVisualType": { "visibleWhen": { "field": "enabled", "equals": "__retired__" } }
    ,"clipCount": { "visibleWhen": { "field": "enabled", "equals": "__retired__" } }
    ,"clipMaximumAgeDays": { "visibleWhen": { "field": "enabled", "equals": "__retired__" } }
    ,"clipMaximumDurationSeconds": { "visibleWhen": { "field": "enabled", "equals": "__retired__" } }
    ,"clipPreferPopular": { "visibleWhen": { "field": "enabled", "equals": "__retired__" } }
    ,"clipMuted": { "visibleWhen": { "field": "enabled", "equals": "__retired__" } }
    ,"clipVolume": { "visibleWhen": { "field": "enabled", "equals": "__retired__" } }
    ,"clipFallbackToCard": { "visibleWhen": { "field": "enabled", "equals": "__retired__" } }
  }
}
