{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Village Lurk Tracker",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": false,
      "title": "Enable lurk tracking"
    },
    "lurkCommand": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,39}$",
      "default": "lurk",
      "title": "Lurk command",
      "description": "Match Viewer Foundation’s lurk command."
    },
    "timeZone": {
      "type": "string",
      "default": "",
      "maxLength": 100,
      "title": "Monthly calendar time zone",
      "description": "Leave blank to use this PC's time zone, or enter an IANA time zone such as America/New_York. Invalid values fall back to this PC's time zone."
    },
    "announceLurk": {
      "type": "boolean",
      "default": true,
      "title": "Thank viewers for lurking"
    },
    "announceReturn": {
      "type": "boolean",
      "default": false,
      "title": "Welcome viewers back in chat"
    },
    "ignoredNames": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80
      },
      "maxItems": 100,
      "default": [],
      "title": "Accounts to ignore",
      "description": "Your broadcaster and connected bot accounts are ignored automatically. Add any other account names here, one per line."
    }
  }
}
