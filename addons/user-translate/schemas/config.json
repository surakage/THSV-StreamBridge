{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Translate",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": { "type": "boolean", "title": "Enable Translate", "default": true },
    "mode": { "type": "string", "title": "Translation mode", "description": "Manual responds only to commands. Automatic translates eligible normal chat. Both enables both paths.", "enum": ["manual", "automatic", "both"], "default": "manual" },
    "enabledPlatforms": { "type": "array", "title": "Enabled platforms", "items": { "type": "string", "enum": ["twitch", "youtube", "kick", "tiktok"] }, "minItems": 1, "maxItems": 4, "uniqueItems": true, "default": ["twitch", "youtube", "kick", "tiktok"] },
    "provider": { "type": "string", "title": "Translation provider", "description": "Google web supports automatic source detection but is an undocumented no-key endpoint. MyMemory is documented but requires a fixed source language.", "enum": ["google-web", "mymemory"], "default": "google-web" },
    "sourceLanguage": { "type": "string", "title": "Source language", "description": "Use auto with Google web, or an explicit code such as es with MyMemory.", "pattern": "^(?:auto|[a-z]{2,3}(?:-[a-z0-9]{2,8})?)$", "maxLength": 20, "default": "auto" },
    "targetLanguage": { "type": "string", "title": "Default output language", "description": "Used by !translate text and automatic mode. Example: en.", "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})?$", "maxLength": 20, "default": "en" },
    "commandPrefix": { "type": "string", "title": "Command prefix", "minLength": 1, "maxLength": 1, "pattern": "^\\S$", "default": "!" },
    "genericCommandName": { "type": "string", "title": "Manual command name", "description": "With the defaults, !translate buenos dias translates into English. No Streamer.bot command object is required.", "pattern": "^[a-z][a-z0-9-]{0,63}$", "default": "translate" },
    "languageCommands": { "type": "array", "title": "Target-language shortcuts", "description": "One code per line. es enables !es hello. These codes also enable the backward-compatible !translate es hello format.", "items": { "type": "string", "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})?$", "maxLength": 20 }, "minItems": 1, "maxItems": 30, "uniqueItems": true, "default": ["en", "es", "fr", "de", "pt"] },
    "tutorialMessage": { "type": "string", "format": "multiline", "title": "Manual help message", "description": "Token: {targetLanguage}.", "minLength": 1, "maxLength": 1000, "default": "Usage: !translate text, !translate {targetLanguage} text, or !{targetLanguage} text. On Twitch, you can also reply with !{targetLanguage}." },
    "responseTemplate": { "type": "string", "format": "multiline", "title": "Manual translation response", "description": "Tokens: {author}, {sourceLanguage}, {targetLanguage}, {translation}.", "minLength": 1, "maxLength": 1000, "default": "{author}: ({targetLanguage}) {translation}" },
    "errorMessage": { "type": "string", "format": "multiline", "title": "Manual provider failure message", "minLength": 1, "maxLength": 500, "default": "Translation is temporarily unavailable. Please try again later." },
    "automaticAudienceMode": { "type": "string", "title": "Automatic translation audience", "enum": ["allowlist-only", "all-viewers"], "default": "allowlist-only" },
    "automaticAllowedNames": { "type": "array", "title": "Automatically translate these viewer names or IDs", "description": "Recommended: start with a small allowlist. One exact platform name or stable ID per line.", "items": { "type": "string", "minLength": 1, "maxLength": 256 }, "maxItems": 500, "uniqueItems": true, "default": [] },
    "automaticIgnoredNames": { "type": "array", "title": "Never automatically translate these names or IDs", "description": "Preloaded with common service bots; add or remove exact login names as needed.", "items": { "type": "string", "minLength": 1, "maxLength": 256 }, "maxItems": 500, "uniqueItems": true, "default": ["nightbot", "streamelements", "fossabot", "moobot", "sery_bot", "soundalerts", "wizebot", "kofistreambot", "botrix", "streamlabs"] },
    "automaticResponseTemplate": { "type": "string", "format": "multiline", "title": "Automatic translation response", "description": "Tokens: {author}, {sourceLanguage}, {targetLanguage}, {translation}.", "minLength": 1, "maxLength": 1000, "default": "{author}: ({sourceLanguage} to {targetLanguage}) {translation}" },
    "showAutomaticErrors": { "type": "boolean", "title": "Post automatic provider failures in chat", "default": false },
    "automaticErrorMessage": { "type": "string", "format": "multiline", "title": "Automatic provider failure message", "minLength": 1, "maxLength": 500, "default": "Automatic translation is temporarily unavailable." },
    "maximumInputCharacters": { "type": "integer", "title": "Maximum input characters", "minimum": 1, "maximum": 1500, "default": 1000 },
    "timeoutSeconds": { "type": "integer", "title": "Provider timeout (seconds)", "minimum": 3, "maximum": 15, "default": 8 },
    "userCooldownSeconds": { "type": "integer", "title": "Per-viewer cooldown (seconds)", "minimum": 5, "maximum": 3600, "default": 15 },
    "globalCooldownSeconds": { "type": "integer", "title": "Global request cooldown (seconds)", "minimum": 1, "maximum": 60, "default": 2 },
    "maximumPendingRequests": { "type": "integer", "title": "Maximum requests waiting", "minimum": 1, "maximum": 20, "default": 10 },
    "maximumTranslationsPerMinute": { "type": "integer", "title": "Maximum automatic translations per minute", "minimum": 1, "maximum": 60, "default": 10 },
    "percentageWindowMessages": { "type": "integer", "title": "Chat messages in percentage window", "minimum": 10, "maximum": 500, "default": 100 },
    "percentageMinimumSample": { "type": "integer", "title": "Messages before percentage cap begins", "minimum": 1, "maximum": 100, "default": 10 },
    "maximumTranslatedPercentage": { "type": "integer", "title": "Maximum automatically translated chat percentage", "minimum": 1, "maximum": 100, "default": 25 }
  }
}
