{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Creator Utility Pack",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": { "type": "boolean", "title": "Enable Creator Utility Pack", "default": true },
    "counterCommand": { "type": "string", "title": "Counter command", "pattern": "^[a-z][a-z0-9-]{0,39}$", "default": "counter" },
    "pollCommand": { "type": "string", "title": "Poll control command", "pattern": "^[a-z][a-z0-9-]{0,39}$", "default": "poll" },
    "voteCommand": { "type": "string", "title": "Poll vote command", "pattern": "^[a-z][a-z0-9-]{0,39}$", "default": "vote" },
    "closePollOnStreamEnd": { "type": "boolean", "title": "Close an active poll when the stream ends", "default": true },
    "maximumCounters": { "type": "integer", "title": "Maximum counters", "minimum": 1, "maximum": 100, "default": 25 },
    "maximumPollOptions": { "type": "integer", "title": "Maximum poll options", "minimum": 2, "maximum": 10, "default": 6 }
  }
}
