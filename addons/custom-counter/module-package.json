      "data/addons/.state/thsv.custom-counter/"
    ],
    "installationSteps": [
      "Install Custom Counter; its separate Streamer.bot controls are optional.",
      "Create distinct counter commands in the wizard. They work through your existing chat connection after restart and need no Streamer.bot actions.",
      "Import the optional controls only for manual hotkeys, Stream Deck buttons, or trusted non-chat triggers.",
      "Add /overlay/addons/thsv.custom-counter as a browser source."
    ],
    "uninstallationSteps": [
      "Uninstalling keeps your counter values and presets for a later reinstall."
    ],
    "migrations": [],
    "healthChecks": [
