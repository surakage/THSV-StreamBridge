  "sections": [
    { "id": "setup", "title": "1. Turn it on and choose games", "open": true, "notice": "Required: install Viewer Foundation, enable Chat Play Pack, then switch on only the games you want viewers to use.", "fields": ["enabled", "numberGuessEnabled", "triviaEnabled", "unscrambleEnabled", "predictionEnabled", "coinFlipEnabled", "slotsEnabled", "rouletteEnabled", "rpsEnabled", "duelEnabled"] },
    { "id": "commands", "title": "2. Included commands", "notice": "The Chat Play .sb import includes all command entries. Existing platform intakes deliver the chat messages, so do not attach triggers or use Command Sync for these commands. Game toggles above decide which commands respond.", "fields": ["commandPrefix", "playCommand", "guessCommand", "answerCommand", "predictCommand", "coinFlipCommand", "slotsCommand", "rouletteCommand", "rpsCommand", "duelCommand", "acceptCommand", "declineCommand"] },
    { "id": "trivia", "title": "3. Trivia setup", "notice": "Twenty questions and answers are already included. Creator library works offline. Mixed tries OpenTDB first and automatically uses this list if the provider is unavailable.", "fields": ["triviaSource", "openTdbCategory", "openTdbDifficulty", "openTdbType", "openTdbBatchSize", "triviaQuestions"] },
    { "id": "unscramble", "title": "4. Unscramble setup", "notice": "Twenty words and hints are already included. Mixed fetches dictionary-backed words in small cached batches and automatically uses this list if fetching fails.", "fields": ["unscrambleSource", "dictionaryBatchSize", "dictionaryMinimumLength", "dictionaryMaximumLength", "unscrambleWords"] },
    { "id": "rewards", "title": "5. Winner points", "notice": "Choose how many Viewer Foundation points each winner receives. Losing never removes points.", "fields": ["awardPoints", "triviaPoints", "unscramblePoints", "coinFlipPoints", "slotsMatchPoints", "slotsJackpotPoints", "roulettePoints", "rouletteGreenPoints", "rpsPoints", "duelPoints"] },
    { "id": "safety", "title": "6. Cooldowns and safety", "notice": "The recommended defaults stop repeated commands from farming points. The hourly limit covers all Chat Play games and survives restarts.", "fields": ["maximumPointsPerViewerPerHour", "instantCooldownSeconds", "roundTimeoutSeconds", "duelCooldownSeconds", "duelRecentViewerMinutes"] },
    { "id": "presentation", "title": "7. Chat and overlay", "notice": "Shared rounds may be announced on every live platform. Solo results reply only where the viewer used the command.", "fields": ["announceSharedRoundsEverywhere", "showOverlayResults"] }
