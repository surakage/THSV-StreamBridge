{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Village Hydration Station",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": { "type": "boolean", "title": "Enable Village Hydration Station", "default": true },
    "automaticReminders": { "type": "boolean", "title": "Run automatic reminders while live", "default": true },
    "reminderIntervalMinutes": { "type": "integer", "title": "Reminder interval (minutes)", "minimum": 5, "maximum": 240, "default": 45 },
    "snoozeMinutes": { "type": "integer", "title": "Snooze duration (minutes)", "minimum": 1, "maximum": 60, "default": 10 },
    "resetMode": { "type": "string", "title": "Reset water total", "enum": ["daily", "stream", "manual"], "default": "daily" },
    "goalOunces": { "type": "integer", "title": "Personal stream goal (ounces)", "description": "A personal display target only, not medical advice.", "minimum": 8, "maximum": 512, "default": 64 },
    "defaultServingOunces": { "type": "integer", "title": "Default button amount (ounces)", "minimum": 1, "maximum": 64, "default": 8 },
    "maximumEntryOunces": { "type": "integer", "title": "Largest accepted single entry (ounces)", "minimum": 1, "maximum": 128, "default": 64 },
    "viewerRemindersEnabled": { "type": "boolean", "title": "Allow viewer hydration reminders", "default": true },
    "twitchRewardId": { "type": "string", "title": "Twitch Hydrate reward ID", "maxLength": 256, "default": "" },
    "kickRewardId": { "type": "string", "title": "Kick Hydrate reward ID", "maxLength": 256, "default": "" },
    "viewerCommand": { "type": "string", "title": "YouTube and TikTok reminder command", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "maxLength": 64, "default": "hydrate" },
    "viewerCommandPlatforms": { "type": "array", "title": "Platforms using the reminder command", "items": { "type": "string", "enum": ["youtube", "tiktok"] }, "minItems": 1, "maxItems": 2, "uniqueItems": true, "default": ["youtube", "tiktok"] },
    "viewerGlobalCooldownMinutes": { "type": "integer", "title": "Cooldown between all viewer reminders (minutes)", "minimum": 1, "maximum": 120, "default": 10 },
    "viewerCooldownMinutes": { "type": "integer", "title": "Per-viewer reminder cooldown (minutes)", "minimum": 1, "maximum": 1440, "default": 60 },
    "creatorCommandEnabled": { "type": "boolean", "title": "Enable protected creator water command", "default": true },
    "creatorCommand": { "type": "string", "title": "Creator water command", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$", "maxLength": 64, "default": "water" },
    "speakerEnabled": { "type": "boolean", "title": "Use Speaker.bot for hydration confirmations", "default": false },
    "voiceAlias": { "type": "string", "title": "Speaker.bot voice alias", "maxLength": 80, "default": "" },
    "automaticReminderMessage": { "type": "string", "title": "Automatic reminder wording", "minLength": 1, "maxLength": 300, "default": "Hydration check. Time for a sip of water." },
    "viewerReminderMessage": { "type": "string", "title": "Viewer reminder wording", "description": "Token: {viewer}", "minLength": 1, "maxLength": 300, "default": "{viewer} is reminding you to drink some water." },
    "loggedMessage": { "type": "string", "title": "Water logged confirmation", "description": "Tokens: {amount}, {total}, {goal}", "minLength": 1, "maxLength": 300, "default": "Logged {amount} ounces. You are at {total} of {goal} ounces." },
    "goalMessage": { "type": "string", "title": "Goal reached confirmation", "description": "Tokens: {total}, {goal}", "minLength": 1, "maxLength": 300, "default": "Hydration goal reached! You logged {total} ounces." },
    "showOverlay": { "type": "boolean", "title": "Show the filling hydration overlay", "default": true },
    "containerStyle": { "type": "string", "title": "Water container", "enum": ["bottle", "glass", "water-tower"], "default": "bottle" },
    "showNumbers": { "type": "boolean", "title": "Show ounce total and goal", "default": true },
    "showNextReminder": { "type": "boolean", "title": "Show next reminder time", "default": true },
    "backgroundMode": { "type": "string", "title": "Overlay background", "enum": ["glass", "solid", "none"], "default": "glass" },
    "backgroundColor": { "type": "string", "title": "Background color", "format": "color", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#0b1720" },
    "backgroundOpacity": { "type": "number", "title": "Background opacity", "minimum": 0, "maximum": 1, "default": 0.9 },
    "waterColor": { "type": "string", "title": "Water color", "format": "color", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#55d6ff" },
    "waterHighlightColor": { "type": "string", "title": "Water highlight", "format": "color", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#b8f3ff" },
    "accentColor": { "type": "string", "title": "Accent color", "format": "color", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#7ff5cc" },
    "textColor": { "type": "string", "title": "Main text color", "format": "color", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#ffffff" },
    "mutedColor": { "type": "string", "title": "Secondary text color", "format": "color", "pattern": "^#[0-9a-fA-F]{6}$", "default": "#c9e7ef" }
  },
  "allOf": [
    { "if": { "properties": { "speakerEnabled": { "const": true } }, "required": ["speakerEnabled"] }, "then": { "properties": { "voiceAlias": { "minLength": 1 } }, "required": ["voiceAlias"] } }
  ]
}
