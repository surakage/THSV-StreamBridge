{
  "intro": "Friendly reminders to pause and take a sip. No bottle sizes or water goals are needed. An optional sip counter counts one acknowledgment per tap.",
  "order": [
    "enabled",
    "displayMode",
    "automaticReminders",
    "reminderIntervalMinutes",
    "snoozeMinutes",
    "resetMode",
    "goalOunces",
    "defaultServingOunces",
    "maximumEntryOunces",
    "viewerRemindersEnabled",
    "twitchRewardId",
    "kickRewardId",
    "viewerCommand",
    "viewerCommandPlatforms",
    "viewerGlobalCooldownMinutes",
    "viewerCooldownMinutes",
    "creatorCommandEnabled",
    "creatorCommand",
    "speakerEnabled",
    "voiceAlias",
    "automaticReminderMessage",
    "viewerReminderMessage",
    "loggedMessage",
    "goalMessage",
    "showOverlay",
    "containerStyle",
    "showNumbers",
    "showNextReminder",
    "backgroundMode",
    "backgroundColor",
    "backgroundOpacity",
    "waterColor",
    "waterHighlightColor",
    "accentColor",
    "textColor",
    "mutedColor",
    "sipMessage"
  ],
  "sections": [
    {
      "id": "basics",
      "title": "1. Sip reminders",
      "open": true,
      "description": "Choose reminders or an optional sip counter, then set the live reminder interval.",
      "notice": "A sip acknowledgment restarts the reminder clock. Timers pause when you are offline.",
      "fields": [
        "displayMode",
        "enabled",
        "goalOunces",
        "defaultServingOunces",
        "resetMode",
        "automaticReminders",
        "reminderIntervalMinutes",
        "snoozeMinutes",
        "maximumEntryOunces"
      ]
    },
    {
      "id": "viewers",
      "title": "2. Viewer reminders",
      "description": "Twitch and Kick use rewards; YouTube and TikTok use !hydrate.",
      "notice": "Viewer reminders prompt a sip; they never count one. Shared and per-viewer cooldowns keep requests from becoming spam.",
      "fields": [
        "viewerRemindersEnabled",
        "twitchRewardId",
        "kickRewardId",
        "viewerCommand",
        "viewerCommandPlatforms",
        "viewerGlobalCooldownMinutes",
        "viewerCooldownMinutes"
      ]
    },
    {
      "id": "controls",
      "title": "3. Creator controls and announcements",
      "description": "Acknowledge one sip using the broadcaster-only chat command !water sip, a Stream Deck button, or a creator hotkey. No amount is needed.",
      "notice": "The existing Log Water action now acknowledges one sip in reminder and sip-counter modes. You can also use !water snooze, remind, undo, reset, or status.",
      "fields": [
        "creatorCommandEnabled",
        "creatorCommand",
        "speakerEnabled",
        "voiceAlias"
      ]
    },
    {
      "id": "wording",
      "title": "4. Messages",
      "description": "Customize reminder and confirmation text. Available tokens appear below each field.",
      "fields": [
        "sipMessage",
        "automaticReminderMessage",
        "viewerReminderMessage",
        "loggedMessage",
        "goalMessage"
      ]
    },
    {
      "id": "overlay",
      "title": "5. Overlay appearance",
      "description": "Style a friendly reminder card. Bottle measurements appear only in optional volume mode.",
      "notice": "Use a 520 x 620 browser source for the compact card. Show the exact template before positioning or cropping it; do not stretch the source.",
      "fields": [
        "showOverlay",
        "containerStyle",
        "showNumbers",
        "showNextReminder",
        "backgroundMode",
        "backgroundColor",
        "backgroundOpacity",
        "waterColor",
        "waterHighlightColor",
        "accentColor",
        "textColor",
        "mutedColor"
      ]
    }
  ],
  "fields": {
    "reminderIntervalMinutes": {
      "visibleWhen": {
        "field": "automaticReminders",
        "equals": true
      }
    },
    "snoozeMinutes": {
      "visibleWhen": {
        "field": "automaticReminders",
        "equals": true
      }
    },
    "twitchRewardId": {
      "visibleWhen": {
        "field": "viewerRemindersEnabled",
        "equals": true
      },
      "placeholder": "Stable Twitch reward ID"
    },
    "kickRewardId": {
      "visibleWhen": {
        "field": "viewerRemindersEnabled",
        "equals": true
      },
      "placeholder": "Stable Kick reward ID"
    },
    "viewerCommand": {
      "visibleWhen": {
        "field": "viewerRemindersEnabled",
        "equals": true
      }
    },
    "viewerCommandPlatforms": {
      "visibleWhen": {
        "field": "viewerRemindersEnabled",
        "equals": true
      }
    },
    "viewerGlobalCooldownMinutes": {
      "visibleWhen": {
        "field": "viewerRemindersEnabled",
        "equals": true
      }
    },
    "viewerCooldownMinutes": {
      "visibleWhen": {
        "field": "viewerRemindersEnabled",
        "equals": true
      }
    },
    "creatorCommand": {
      "visibleWhen": {
        "field": "creatorCommandEnabled",
        "equals": true
      },
      "placeholder": "water"
    },
    "voiceAlias": {
      "visibleWhen": {
        "field": "speakerEnabled",
        "equals": true
      },
      "placeholder": "Reuses Village Voice when available"
    },
    "containerStyle": {
      "labels": {
        "bottle": "Village bottle",
        "glass": "Water glass",
        "water-tower": "Village water tower"
      },
      "visibleWhen": {
        "field": "displayMode",
        "equals": "volume"
      }
    },
    "backgroundMode": {
      "labels": {
        "glass": "Translucent glass",
        "solid": "Solid",
        "none": "No background"
      }
    },
    "backgroundColor": {
      "visibleWhen": {
        "field": "backgroundMode",
        "notEquals": "none"
      }
    },
    "backgroundOpacity": {
      "visibleWhen": {
        "field": "backgroundMode",
        "notEquals": "none"
      }
    },
    "displayMode": {
      "labels": {
        "reminder": "Friendly reminders (recommended)",
        "sips": "Reminders with a sip counter",
        "volume": "Optional ounce tracking (legacy)"
      }
    },
    "goalOunces": {
      "visibleWhen": {
        "field": "displayMode",
        "equals": "volume"
      }
    },
    "defaultServingOunces": {
      "visibleWhen": {
        "field": "displayMode",
        "equals": "volume"
      }
    },
    "maximumEntryOunces": {
      "visibleWhen": {
        "field": "displayMode",
        "equals": "volume"
      }
    },
    "loggedMessage": {
      "visibleWhen": {
        "field": "displayMode",
        "equals": "volume"
      }
    },
    "goalMessage": {
      "visibleWhen": {
        "field": "displayMode",
        "equals": "volume"
      }
    },
    "showNumbers": {
      "visibleWhen": {
        "field": "displayMode",
        "equals": "volume"
      }
    },
    "sipMessage": {
      "visibleWhen": {
        "field": "displayMode",
        "notEquals": "volume"
      }
    }
  }
}