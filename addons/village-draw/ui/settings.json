{
  "intro": "Village Draw runs one giveaway at a time across all your chats. Set it up in three short steps, then run it from the Control Panel (Village Draw tab): start, see who joined, draw, and end.",
  "order": [
    "enabled",
    "giveawayName",
    "prizeItem",
    "winnerCount",
    "description",
    "prizeImageUrl",
    "entryMode",
    "ticketCost",
    "maxTicketsPerViewer",
    "eligiblePlatforms",
    "entryRoles",
    "subscriberLuck",
    "vipLuck",
    "skipRecentWinners",
    "maximumEntrants",
    "maximumTotalTickets",
    "autoCloseMinutes",
    "reminderMinutes",
    "claimSeconds",
    "claimMode",
    "noClaimAction",
    "streamEndBehavior",
    "announcementPlatforms",
    "openMessage",
    "reminderMessage",
    "lastCallMessage",
    "closedMessage",
    "winnerMessage",
    "claimMessage",
    "claimedMessage",
    "noClaimMessage",
    "endedMessage",
    "canceledMessage",
    "confirmationMessage",
    "commandPrefix",
    "giveawayCommand",
    "enterCommand",
    "ticketsCommand",
    "myTicketsCommand",
    "claimCommand",
    "winnersCommand",
    "showOpenCard",
    "showWinnerCard",
    "ticketLayout",
    "drawAnimationSeconds",
    "cardSeconds",
    "winnerOverlayMessage",
    "showPrizeImage",
    "showWinnerAvatar",
    "showPlatformBadge",
    "showEntryCount",
    "showConfetti",
    "playWinnerTone",
    "backgroundColor",
    "backgroundOpacity",
    "accentColor",
    "winnerColor",
    "textColor",
    "fontFamily"
  ],
  "sections": [
    {
      "id": "what",
      "title": "1. What are you giving away?",
      "open": true,
      "description": "Name the giveaway and the prize. Viewer Foundation must be turned on first.",
      "notice": "Village Draw is for casual community giveaways. Do not use it for paid entry, gambling, regulated drawings, or high-value prizes without proper advice.",
      "fields": [
        "enabled",
        "giveawayName",
        "prizeItem",
        "winnerCount",
        "description",
        "prizeImageUrl"
      ]
    },
    {
      "id": "who",
      "title": "2. Who can enter?",
      "description": "Free entry is the simplest. Points tickets spend Viewer Foundation points and are refunded if you cancel.",
      "fields": [
        "entryMode",
        "ticketCost",
        "maxTicketsPerViewer",
        "eligiblePlatforms",
        "entryRoles",
        "subscriberLuck",
        "vipLuck",
        "skipRecentWinners",
        "maximumEntrants",
        "maximumTotalTickets"
      ]
    },
    {
      "id": "how",
      "title": "3. How does it run?",
      "description": "Optional timers. Leave them as they are for a simple giveaway you close yourself.",
      "fields": [
        "autoCloseMinutes",
        "reminderMinutes",
        "claimSeconds",
        "claimMode",
        "noClaimAction",
        "streamEndBehavior"
      ]
    },
    {
      "id": "messages",
      "title": "Chat messages",
      "description": "Pick which chats get the giveaway messages, then change any text you like.",
      "notice": "Words you can use: {name}, {prize}, {entryCommand}, {entrants}, {tickets}, {timeLeft}, {winner}, {winners}, {seconds}, {claimCommand}, and in the entry reply {viewer}, {points}, {currency}.",
      "fields": [
        "announcementPlatforms",
        "openMessage",
        "reminderMessage",
        "lastCallMessage",
        "closedMessage",
        "winnerMessage",
        "claimMessage",
        "claimedMessage",
        "noClaimMessage",
        "endedMessage",
        "canceledMessage",
        "confirmationMessage"
      ]
    },
    {
      "id": "commands",
      "title": "Chat commands",
      "description": "Read straight from Twitch, YouTube, Kick and TikTok chat. Only you and your moderators can run the giveaway from chat.",
      "fields": [
        "commandPrefix",
        "giveawayCommand",
        "enterCommand",
        "ticketsCommand",
        "myTicketsCommand",
        "claimCommand",
        "winnersCommand"
      ]
    },
    {
      "id": "overlay-behavior",
      "title": "Prize ticket overlay",
      "description": "The overlay cycles entrant names, reveals the winner and shows the claim countdown.",
      "fields": [
        "showOpenCard",
        "showWinnerCard",
        "ticketLayout",
        "drawAnimationSeconds",
        "cardSeconds",
        "winnerOverlayMessage"
      ]
    },
    {
      "id": "overlay-content",
      "title": "Shown on the ticket",
      "description": "Turn off anything you do not want on the winner ticket.",
      "fields": [
        "showPrizeImage",
        "showWinnerAvatar",
        "showPlatformBadge",
        "showEntryCount",
        "showConfetti",
        "playWinnerTone"
      ]
    },
    {
      "id": "overlay-style",
      "title": "Ticket look",
      "description": "The default is a compact see-through ticket.",
      "fields": [
        "backgroundColor",
        "backgroundOpacity",
        "accentColor",
        "winnerColor",
        "textColor",
        "fontFamily"
      ]
    }
  ],
  "fields": {
    "ticketCost": {
      "visibleWhen": {
        "field": "entryMode",
        "in": [
          "points-single",
          "points-multiple"
        ]
      }
    },
    "maxTicketsPerViewer": {
      "visibleWhen": {
        "field": "entryMode",
        "equals": "points-multiple"
      }
    },
    "claimMode": {
      "labels": {
        "any-message": "Say anything in chat",
        "claim-command": "Type the claim command"
      }
    },
    "noClaimAction": {
      "labels": {
        "wait": "Wait for me to draw again",
        "redraw": "Draw someone else right away"
      }
    },
    "entryRoles": {
      "labels": {
        "everyone": "Everyone",
        "subscribers": "Subs & members",
        "vips": "VIPs",
        "moderators": "Moderators"
      }
    },
    "entryMode": {
      "labels": {
        "free-single": "Free, one entry each",
        "points-single": "One ticket for points",
        "points-multiple": "Several tickets for points"
      }
    },
    "streamEndBehavior": {
      "labels": {
        "close": "Close entries",
        "pause": "Pause entries",
        "leave-open": "Leave entries open"
      }
    },
    "prizeImageUrl": {
      "placeholder": "https://..."
    }
  }
}
