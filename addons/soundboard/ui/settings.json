{
  "intro": "Your own soundboard. Add sounds from this PC, then play them from the Control Panel, a chat command or a channel point reward. Sounds play on one browser page, in OBS, SprigCast, Streamlabs and Meld. No Streamer.bot import is needed.",
  "order": [
    "enabled",
    "sounds",
    "volume",
    "letSoundsOverlap",
    "maximumAtOnce",
    "longestSoundSeconds",
    "commandPlatforms",
    "commandAccess",
    "globalCooldownSeconds",
    "viewerCooldownSeconds",
    "soundCooldownSeconds",
    "cooldownMessage",
    "listCommand",
    "listMessage",
    "stopCommand"
  ],
  "sections": [
    {
      "id": "sounds",
      "title": "1. Sounds",
      "description": "Nothing is set up yet. Add your own sounds, or press Add examples and pick a file for each.",
      "open": true,
      "fields": [
        "enabled",
        "sounds"
      ]
    },
    {
      "id": "page",
      "title": "2. Sound page",
      "fields": [
        "volume",
        "letSoundsOverlap",
        "maximumAtOnce",
        "longestSoundSeconds"
      ],
      "notice": "Add http://127.0.0.1:8787/overlay/addons/thsv.soundboard as a browser source in every scene where sounds should be heard. It shows nothing. Add it on one canvas only (your horizontal one), so each sound is heard once, and keep it running when hidden. SprigCast pages can't play MP3 files, so use WAV or OGG there."
    },
    {
      "id": "chat",
      "title": "3. Chat commands",
      "fields": [
        "commandPlatforms",
        "commandAccess",
        "globalCooldownSeconds",
        "viewerCooldownSeconds",
        "soundCooldownSeconds",
        "cooldownMessage",
        "listCommand",
        "listMessage",
        "stopCommand"
      ],
      "notice": "Cooldowns apply to chat commands only. You and your moderators skip them."
    }
  ],
  "fields": {
    "sounds": {
      "control": "row-list",
      "itemLabel": "sound",
      "columns": [
        {
          "label": "Name",
          "hint": "Button name",
          "placeholder": "Airhorn",
          "maxLength": 60,
          "width": "1fr",
          "required": true
        },
        {
          "label": "Sound file",
          "hint": "MP3, WAV or OGG",
          "type": "sound",
          "maxLength": 1000,
          "width": "1.6fr"
        },
        {
          "label": "Volume %",
          "hint": "0 to 100",
          "placeholder": "100",
          "type": "number",
          "min": 0,
          "max": 100,
          "width": "8rem"
        },
        {
          "label": "Chat command",
          "hint": "Optional, without !",
          "placeholder": "airhorn",
          "maxLength": 40,
          "width": "1fr"
        },
        {
          "label": "Twitch reward ID",
          "hint": "Optional",
          "placeholder": "Twitch ID",
          "maxLength": 256,
          "width": "1.2fr"
        },
        {
          "label": "Kick reward ID",
          "hint": "Optional",
          "placeholder": "Kick ID",
          "maxLength": 256,
          "width": "1.2fr"
        }
      ],
      "examples": [
        "Airhorn | | 80 | airhorn | |",
        "Applause | | 70 | applause | |",
        "Drum roll | | 70 | drumroll | |"
      ]
    },
    "listMessage": {
      "visibleWhen": {
        "field": "listCommand",
        "notEquals": ""
      }
    },
    "commandAccess": {
      "labels": {
        "everyone": "Everyone",
        "subscribers": "Subscribers and members",
        "vips": "VIPs and up",
        "moderators": "Moderators only"
      }
    }
  }
}
