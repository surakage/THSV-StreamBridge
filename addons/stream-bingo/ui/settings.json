{
  "intro": "One shared bingo card on stream for your whole community. Squares tick by themselves when things happen (follows, subs, Bits, gifts, tips, raids, rewards, chat words) or when a moderator marks them. Viewers type !bingo to join, and each bingo draws one fair winner from everyone who joined. No Streamer.bot import is needed.",
  "order": [
    "enabled",
    "platforms",
    "bingoCommand",
    "squarePack",
    "squares",
    "gamingPack",
    "chattingPack",
    "gridSize",
    "freeCenter",
    "winPattern",
    "afterWin",
    "newCardSeconds",
    "winnerPoints",
    "joinPoints",
    "blackoutBonus",
    "hypeMinutes",
    "confirmJoins",
    "joinMessage",
    "announceNewCard",
    "newCardMessage",
    "winMessage",
    "noWinnerMessage",
    "statsMessage",
    "topMessage",
    "noWinsMessage",
    "noCardMessage",
    "bonusMessage",
    "hypeMessage",
    "title",
    "layout",
    "position",
    "cardSize",
    "showNumbers",
    "showPlayers",
    "showRecent",
    "winSeconds",
    "markColor",
    "hintText",
    "playersLabel",
    "freeText",
    "bingoWord",
    "bonusWord",
    "nobodyText",
    "patternNames",
    "timeZone",
    "suggestionsEnabled",
    "suggestMessage",
    "discordWebhookId",
    "discordWins",
    "discordMonthly",
    "discordRecapMessage",
    "winActionId"
  ],
  "sections": [
    {
      "id": "start",
      "title": "1. Turn on bingo",
      "open": true,
      "fields": [
        "enabled",
        "platforms",
        "bingoCommand"
      ],
      "notice": "Viewers type !bingo to join. Moderators type !bingo mark 7 (or unmark, new, end). You can also press the buttons in the Control Panel, or point a Stream Deck button at a Streamer.bot action that sends !bingo mark 7 from your own account."
    },
    {
      "id": "squares",
      "title": "2. Squares",
      "fields": [
        "squarePack",
        "squares",
        "gamingPack",
        "chattingPack"
      ],
      "notice": "Squares tick only on a running card. Simulated test events never tick a square; use Mark in the Control Panel to try it out."
    },
    {
      "id": "rules",
      "title": "3. Rules and prizes",
      "fields": [
        "gridSize",
        "freeCenter",
        "winPattern",
        "afterWin",
        "newCardSeconds",
        "winnerPoints",
        "joinPoints",
        "blackoutBonus",
        "hypeMinutes"
      ],
      "notice": "Every player has the same chance in the draw, whichever platform they joined from. Linked accounts count as one player."
    },
    {
      "id": "chat",
      "title": "4. Chat messages",
      "fields": [
        "confirmJoins",
        "joinMessage",
        "announceNewCard",
        "newCardMessage",
        "winMessage",
        "noWinnerMessage",
        "statsMessage",
        "topMessage",
        "noWinsMessage",
        "noCardMessage",
        "bonusMessage",
        "hypeMessage"
      ]
    },
    {
      "id": "look",
      "title": "5. On stream",
      "fields": [
        "title",
        "layout",
        "position",
        "cardSize",
        "showNumbers",
        "showPlayers",
        "showRecent",
        "winSeconds",
        "markColor"
      ],
      "notice": "Add http://127.0.0.1:8787/overlay/addons/thsv.stream-bingo as a 1920x1080 browser source (1080x1920 on a vertical canvas). These settings also change live from the Control Panel."
    },
    {
      "id": "words",
      "title": "6. Words on the card",
      "fields": [
        "hintText",
        "playersLabel",
        "freeText",
        "bingoWord",
        "bonusWord",
        "nobodyText",
        "patternNames"
      ],
      "notice": "Change these to match your language or your community's style."
    },
    {
      "id": "stats",
      "title": "7. Monthly stats",
      "fields": [
        "timeZone"
      ],
      "notice": "Wins count per month and reset on the 1st; last month's top three move to the hall of fame. All-time wins never reset. Viewers type !bingo stats or !bingo top."
    },
    {
      "id": "ideas",
      "title": "8. Square ideas from chat",
      "fields": [
        "suggestionsEnabled",
        "suggestMessage"
      ],
      "notice": "Nothing a viewer sends goes on the card until you press Add in the Control Panel."
    },
    {
      "id": "connect",
      "title": "9. Discord and Streamer.bot",
      "fields": [
        "discordWebhookId",
        "discordWins",
        "discordMonthly",
        "discordRecapMessage",
        "winActionId"
      ],
      "notice": "Both are optional. The Streamer.bot action must also be approved in the Approve Streamer.bot actions step."
    }
  ],
  "fields": {
