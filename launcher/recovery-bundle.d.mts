export interface RecoveryBundleOptions { installRoot: string; passphrase: string; }
export function exportRecoveryBundle(options: RecoveryBundleOptions & { outputPath: string; overwrite?: boolean }): Promise<{ outputPath: string; fileCount: number; plaintextBytes: number; encrypted: true; verified: true }>;
