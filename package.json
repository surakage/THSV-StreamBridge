{
  "name": "@thsv/streambridge",
  "version": "4.0.7",
  "private": true,
  "license": "MIT",
  "description": "A modular, local-first cross-platform livestream automation framework",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "addon:verify": "tsx tools/manage-addon.ts verify",
    "addon:install": "tsx tools/manage-addon.ts install",
    "addon:package": "tsx tools/package-addon.ts",
    "addon:remove": "tsx tools/manage-addon.ts remove",
    "clean": "node tools/clean.mjs",
    "config:validate": "tsx tools/validate-config.ts",
    "docs:addons": "tsx tools/generate-addon-setup-docs.ts",
    "dev": "node tools/dev.mjs",
    "lint": "eslint .",
    "package:streamerbot": "tsx tools/build-streamerbot-export.ts",
    "imports:sync": "tsx tools/sync-streamerbot-imports.ts",
    "release:sync-version": "tsx tools/sync-release-version.ts",
    "simulate": "tsx tools/simulate-event.ts",
    "simulate:burst": "tsx tools/simulate-burst.ts",
    "start": "node dist/apps/bridge-service.js",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "test:broadcast-vendors": "node tools/accept-broadcast-vendors.mjs",
    "test:startup-chaos": "node tools/run-startup-chaos.mjs",
    "test:integration": "vitest run tests/integration",
    "test:unit": "vitest run tests/unit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "sigstore": "5.0.0",
    "snappyjs": "0.7.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.7.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
